#!/usr/bin/env node
// agent-kit-install — install the COMMITTED state of ~/agent-kit as a release.
//
//   ~/.agent-kit/releases/<sha>/   one directory per installed commit (git archive)
//   ~/.agent-kit/current           symlink to the active release, switched atomically
//   ~/.agent-kit/history.jsonl     {at, sha, previous, commit, action} per switch
//
// Everything user-level is tied to `current`, never to a release, so a
// rollback is one symlink switch: the `collab` launcher and the MCP
// registrations (Claude, Codex, Gemini) point through it, and a Windows skill
// directory is a junction
// through it. What Claude Code does not see through a link is copied instead,
// and those copies are rewritten from the release switched to, in the same
// run: on POSIX the skills, the agents and the orchestration rule; on Windows
// the agents and the rule (its skill junctions need no copy). The one
// asymmetry: a release older than such an entry has nothing to copy, so the
// installed copy is kept as it is rather than removed (see applyLinks*).
//
// ORDER OF WORK. Checks that can refuse (dirty source, foreign files at link
// destinations, a foreign Claude registration, an unrewritable Codex config)
// run BEFORE the minute-long build, and again right before anything changes.
// Every change is recorded in an undo journal; if any later step fails, the
// run is undone in reverse and the error names what was undone. Pruning old
// releases is the only irreversible step and runs last, after success.
//
// Deliberately stdlib only and CommonJS (no extension, no package.json), like
// bin/collab. Usage: agent-kit-install --help
'use strict'

const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')
const crypto = require('node:crypto')
const { spawn, spawnSync } = require('node:child_process')
const { pathToFileURL } = require('node:url')

const KEEP_RELEASES = 3
const MIN_NODE_MAJOR = 18
const IS_WINDOWS = process.platform === 'win32'
// Windows has no chmod-style executable bit; the shell (and libuv's own PATH
// search) instead tries each of these extensions in order. Read once at
// startup, not per lookup, so a `--bindir`/env change mid-run can't matter.
const PATHEXT = Object.freeze(
  (process.env.PATHEXT || '.COM;.EXE;.BAT;.CMD').split(';').map((e) => e.trim().toLowerCase()).filter(Boolean)
)
// No single default is right everywhere: Apple Silicon Homebrew, Intel
// Homebrew and a typical Linux box each expect launchers in a different
// place; Windows has no package-manager bin dir at all, so the one directory
// that is (a) writable without admin and (b) already on a fresh user's PATH
// is %LOCALAPPDATA%\Microsoft\WindowsApps (Windows adds it for per-user app
// execution aliases since the 2017 Fall Creators Update). The first of these
// that already exists as a directory wins; none existing is a clear,
// actionable error (--bindir) instead of a silent single-OS assumption.
const BINDIR_CANDIDATES = Object.freeze(
  IS_WINDOWS
    ? [process.env.LOCALAPPDATA ? path.join(process.env.LOCALAPPDATA, 'Microsoft', 'WindowsApps') : null].filter(Boolean)
    : ['/opt/homebrew/bin', '/usr/local/bin']
)
const SERVER_REL = 'collab/src/mcp/server.mjs'
const REQUIRED_PATHS = Object.freeze([
  'agents/implementer.md',
  'agents/verifier.md',
  'rules/orchestration.md',
  'rules/modules.md',
  'rules/terminology.md',
  'rules/apple-toolchain.md',
  'skills/codex-review/SKILL.md',
  'skills/ui-review/SKILL.md',
  'skills/ux-guidance/SKILL.md',
  'skills/ux-critic-review/SKILL.md',
  'hooks/scope-guard.py',
  'hooks/readonly-guard.py',
  'bin/collab',
  'bin/apple-lock',
  'collab/src/mcp/server.mjs',
  'collab/src/mcp/tools.mjs',
  'collab/test'
])
// The node written into both registrations. A stable symlink survives a Node
// upgrade; process.execPath (a Homebrew Cellar path) does not. On Windows the
// official installer always lands at Program Files and rewrites in place on
// upgrade, so there is no Cellar-style moving target to guard against.
const NODE_CANDIDATES = Object.freeze(
  IS_WINDOWS
    ? ['C:\\Program Files\\nodejs\\node.exe', 'C:\\Program Files (x86)\\nodejs\\node.exe']
    : ['/opt/homebrew/bin/node', '/usr/local/bin/node', '/usr/bin/node']
)
const GIT_CANDIDATES = Object.freeze(
  IS_WINDOWS
    ? ['C:\\Program Files\\Git\\bin\\git.exe', 'C:\\Program Files\\Git\\cmd\\git.exe', 'C:\\Program Files (x86)\\Git\\bin\\git.exe']
    : ['/usr/bin/git', '/opt/homebrew/bin/git', '/usr/local/bin/git']
)
// %WINDIR%\System32\tar.exe (shipped since Windows 10 1803) is a bsdtar
// build — the same dialect as macOS's own /usr/bin/tar, so the `-xf ... -C`
// flags used below need no platform branch.
const TAR = IS_WINDOWS ? path.join(process.env.WINDIR || 'C:\\Windows', 'System32', 'tar.exe') : '/usr/bin/tar'
const RELEASE_NAME = /^[0-9a-f]{7,40}$/
const RESTART = 'перезапустите открытые сессии Claude, Codex и Gemini'


class InstallError extends Error {}

// ── small helpers ──────────────────────────────────────────────────────────

const lstatOrNull = (p) => {
  try {
    return fs.lstatSync(p)
  } catch {
    return null
  }
}
const realpathOr = (p) => {
  try {
    return fs.realpathSync(p)
  } catch {
    return path.resolve(p)
  }
}
const rand = () => crypto.randomBytes(4).toString('hex')
const sha256 = (buf) => crypto.createHash('sha256').update(buf).digest('hex')
// NTFS is case-preserving but case-insensitive, and git-for-windows can hand
// back a differently-cased drive letter than fs.realpathSync does — so an
// exact string compare of two "identical" paths can spuriously fail there.
const samePath = (a, b) => (IS_WINDOWS ? path.normalize(a).toLowerCase() === path.normalize(b).toLowerCase() : a === b)
const isInside = (child, parent) => samePath(child, parent) || (IS_WINDOWS ? path.normalize(child).toLowerCase() : child).startsWith((IS_WINDOWS ? path.normalize(parent).toLowerCase() : parent) + path.sep)
// This string is only ever printed as a paste-and-run hint (rollbackCommand),
// never executed by this process — POSIX single-quote escaping is simply
// invalid syntax in cmd.exe/PowerShell, so Windows gets its own quoting.
const shellQuote = IS_WINDOWS
  ? (s) => (/^[\w@%+=:,./\\-]+$/.test(s) ? s : `"${String(s).replace(/"/g, '""')}"`)
  : (s) => (/^[\w@%+=:,./-]+$/.test(s) ? s : `'${String(s).replace(/'/g, `'\\''`)}'`)
const out = (line = '') => process.stdout.write(`${line}\n`)
const tail = (text, n = 40) => String(text || '').split('\n').slice(-n).join('\n')
// One line is enough to say why a vendor call failed; the rest belongs in its own output.
const firstLine = (text) => String(text || '').split('\n').find((l) => l.trim()) || ''

function describeEntry(st) {
  if (st.isDirectory()) return 'directory'
  if (st.isFile()) return 'regular file'
  return 'special file'
}

// process.env is case-insensitive on Windows (the real variable is usually
// spelled "Path", not "PATH") but a plain object copied from it is not: two
// differently-cased keys would both survive and whichever a child's libc
// reads first wins. Finding and overwriting the existing key (instead of
// always adding "PATH") keeps there being exactly one.
function pathKeyOf(env) {
  if (!IS_WINDOWS) return 'PATH'
  return Object.keys(env).find((k) => k.toUpperCase() === 'PATH') || 'PATH'
}
function setPath(env, dirs) {
  const key = pathKeyOf(env)
  for (const k of Object.keys(env)) if (k.toUpperCase() === 'PATH' && k !== key) delete env[k]
  env[key] = dirs.join(path.delimiter)
  return env
}

// The environment for child processes that run kit code (tests, smoke): no
// COLLAB_* identity leaking in, no GIT_* redirecting git, no loader tricks, and
// no NODE_TEST_CONTEXT — when this installer itself runs under `node --test`,
// that variable would turn the kit's `node --test` into a silent child reporter.
function childEnv(extra = {}) {
  const env = {}
  for (const [key, value] of Object.entries(process.env)) {
    if (/^(COLLAB_|GIT_|DYLD_)/.test(key)) continue
    if (['NODE_OPTIONS', 'NODE_TEST_CONTEXT', 'LD_PRELOAD', 'LD_LIBRARY_PATH'].includes(key)) continue
    env[key] = value
  }
  setPath(env, [path.dirname(process.execPath), process.env[pathKeyOf(process.env)] || (IS_WINDOWS ? '' : '/usr/bin:/bin')])
  return { ...env, ...extra }
}

// git: absolute path, sanitised env with a fixed PATH.
const GIT = GIT_CANDIDATES.find((p) => {
  try {
    const st = fs.statSync(p)
    return st.isFile() && (IS_WINDOWS || (st.mode & 0o111) !== 0)
  } catch {
    return false
  }
})
function gitEnv() {
  const env = childEnv()
  setPath(
    env,
    IS_WINDOWS
      ? [path.dirname(process.execPath), path.dirname(GIT || ''), process.env.WINDIR ? path.join(process.env.WINDIR, 'System32') : 'C:\\Windows\\System32']
      : [path.dirname(process.execPath), '/usr/bin', '/bin', '/usr/sbin', '/sbin', '/opt/homebrew/bin', '/usr/local/bin']
  )
  return env
}
function git(cwd, args) {
  if (!GIT) throw new InstallError(`no git found at ${GIT_CANDIDATES.join(', ')}`)
  const r = spawnSync(GIT, args, { cwd, env: gitEnv(), encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 })
  if (r.error) throw new InstallError(`git ${args.join(' ')}: ${r.error.message}`)
  return r
}

// NTFS has no chmod-style executable bit. Node approximates one for a small
// set of recognised extensions (.exe/.cmd/.bat/.com), which is enough for the
// absolute candidates above (already spelled with .exe) — so on Windows this
// only needs to answer "does a file exist here", and PATHEXT-extension
// guessing for bare names is commandExists()'s job, not this function's.
function isExecutableFile(p) {
  try {
    const st = fs.statSync(p)
    if (!st.isFile()) return false
    return IS_WINDOWS || (st.mode & 0o111) !== 0
  } catch {
    return false
  }
}

// First existing NODE_CANDIDATE, kept as that (symlink) path. Otherwise the
// realpath of what a PATH scan finds, with a warning.
function resolveNode({ candidates = NODE_CANDIDATES, pathEnv = process.env[pathKeyOf(process.env)] || '' } = {}) {
  for (const candidate of candidates) if (isExecutableFile(candidate)) return { path: candidate, warning: null }
  const names = IS_WINDOWS ? ['node.exe', 'node.cmd'] : ['node']
  for (const dir of pathEnv.split(path.delimiter)) {
    if (!dir || !path.isAbsolute(dir)) continue
    for (const name of names) {
      const found = path.join(dir, name)
      if (!isExecutableFile(found)) continue
      const real = fs.realpathSync(found)
      return {
        path: real,
        warning: `none of ${candidates.join(', ') || '(no candidates)'} exists; registering ${real} (resolved from PATH), which may break when Node is upgraded`
      }
    }
  }
  throw new InstallError(`no node found: none of ${candidates.join(', ') || '(no candidates)'} exists and there is no node on PATH`)
}

// First existing BINDIR_CANDIDATE. Unlike resolveNode there is no PATH-scan
// fallback — a launcher (symlink on POSIX, .cmd shim on Windows) needs a
// specific directory chosen on purpose, not the first directory some command
// happens to resolve into.
function resolveBindir(explicit, { candidates = BINDIR_CANDIDATES } = {}) {
  if (explicit) {
    const resolved = path.resolve(explicit)
    if (!lstatOrNull(resolved) || !fs.statSync(resolved).isDirectory()) throw new InstallError(`bindir ${resolved} is not a directory`)
    return resolved
  }
  for (const candidate of candidates) {
    if (lstatOrNull(candidate) && fs.statSync(candidate).isDirectory()) return candidate
  }
  throw new InstallError(`no usable bindir found among ${candidates.join(', ')} — pass --bindir explicitly`)
}

// Whether a command is runnable without spawning it: an absolute/relative
// path is checked directly, a bare name is scanned across PATH exactly like a
// shell would — on Windows that includes trying each PATHEXT extension in
// turn (npm-installed CLIs like claude/codex/agy ship as .cmd shims there,
// never as an extension-less file). Used to decide whether a vendor's CLI is
// even present before planning to touch its config — a vendor with no CLI
// installed yet should not be told apart from one that errored.
function commandExists(cmd) {
  if (!cmd) return false
  const hasSep = cmd.includes(path.sep) || (IS_WINDOWS && cmd.includes('/'))
  const candidatesFor = (base) => {
    if (!IS_WINDOWS) return [base]
    const lower = base.toLowerCase()
    if (PATHEXT.some((ext) => lower.endsWith(ext))) return [base]
    return [base, ...PATHEXT.map((ext) => base + ext)]
  }
  if (hasSep) return candidatesFor(cmd).some(isExecutableFile)
  for (const dir of (process.env[pathKeyOf(process.env)] || '').split(path.delimiter)) {
    if (!dir) continue
    if (candidatesFor(path.join(dir, cmd)).some(isExecutableFile)) return true
  }
  return false
}

// ── undo journal ───────────────────────────────────────────────────────────

class Journal {
  constructor() {
    this.steps = []
  }
  add(description, undo) {
    this.steps.push({ description, undo })
  }
  rollback() {
    const report = []
    for (const step of this.steps.slice().reverse()) {
      try {
        step.undo()
        report.push(`undone: ${step.description}`)
      } catch (error) {
        report.push(`FAILED to undo ${step.description}: ${error.message}`)
      }
    }
    this.steps = []
    return report
  }
}

// mkdir -p that records the directories it created (removed on undo if empty).
function ensureDir(dir, journal) {
  const missing = []
  let cursor = path.resolve(dir)
  while (!lstatOrNull(cursor)) {
    missing.unshift(cursor)
    const parent = path.dirname(cursor)
    if (parent === cursor) break
    cursor = parent
  }
  const st = fs.statSync(cursor)
  if (!st.isDirectory()) throw new InstallError(`${cursor} exists and is not a directory`)
  for (const d of missing) {
    fs.mkdirSync(d)
    journal?.add(`created directory ${d}`, () => {
      if (lstatOrNull(d) && fs.readdirSync(d).length === 0) fs.rmdirSync(d)
    })
  }
  return missing
}

// `type` matters only on Windows ('file' | 'dir' | 'junction'); POSIX ignores
// it. Left undefined, Node auto-detects by statting `target` — which, for a
// *relative* target, resolves against process.cwd(), not dest's own
// directory, and guesses wrong. Every Windows call site below passes an
// explicit type and an absolute target for exactly that reason.
function atomicSymlink(target, dest, type) {
  const tmp = path.join(path.dirname(dest), `.${path.basename(dest)}.agent-kit-tmp-${process.pid}-${rand()}`)
  fs.symlinkSync(target, tmp, type)
  try {
    fs.renameSync(tmp, dest)
  } catch (error) {
    fs.rmSync(tmp, { force: true })
    throw error
  }
}

// `mode` (0o600 for Codex/Gemini configs, the lock file) is a no-op on
// Windows: NTFS has no POSIX permission bits, and Node only approximates one
// by toggling the read-only attribute — it does not restrict the file to the
// current user the way 0o600 does on POSIX. Real confidentiality there would
// need an explicit ACL (icacls-equivalent), which this installer does not
// set; on a personal single-user Windows machine that gap is accepted, not
// fixed, and is called out here rather than left silent.
function writeFileAtomic(file, buffer, mode) {
  const tmp = `${file}.agent-kit-tmp-${process.pid}-${rand()}`
  const fd = fs.openSync(tmp, 'wx', mode)
  try {
    fs.writeSync(fd, buffer)
    fs.fsyncSync(fd)
  } finally {
    fs.closeSync(fd)
  }
  try {
    fs.chmodSync(tmp, mode)
    fs.renameSync(tmp, file)
  } catch (error) {
    fs.rmSync(tmp, { force: true })
    throw error
  }
}

// ── arguments ──────────────────────────────────────────────────────────────

const HELP = `usage: agent-kit-install [options]

Installs the committed HEAD of the source repository as ~/.agent-kit/releases/<sha>,
switches ~/.agent-kit/current to it, links skills/agents/rules/collab and registers the
collab MCP server with Claude Code (user scope) and Codex.

  --source <dir>       source git repository (default: <home>/agent-kit)
  --home <dir>         home directory to install into (default: $HOME)
  --bindir <dir>       where the collab launcher is linked (default: first of ${BINDIR_CANDIDATES.join(', ')} that exists)
  --claude-bin <path>  Claude Code executable (default: claude)
  --claude-config-dir <dir>  another Claude Code config directory to install into
                       (repeatable; must be inside the home; CLAUDE_CONFIG_DIR is
                       picked up automatically when it points inside the home)
  --replace-claude     replace a different user-scope "collab" MCP registration
  --skip-claude        do not register with Claude Code even if it is on PATH
  --skip-codex         do not touch ~/.codex/config.toml
  --skip-gemini        do not touch ~/.gemini/config/mcp_config.json
  --dry-run            run every check, tests and smoke included; change nothing
  --rollback           switch current back to the previous release
  -h, --help           this text

Claude Code reads skills, agents and rules only from the config directory the
session runs under (verified 2026-09-18: a session with CLAUDE_CONFIG_DIR set
sees that directory and no other), so an account with its own directory needs
its own copies. Every config directory gets them, and each is registered with
the collab MCP server separately. A registration that fails in an extra
directory (a disabled account, for instance) is reported and the install
stands; in the default directory it is still fatal, as it always was. A
directory is accepted only if its real path — symlinks resolved — is inside
the home being installed into.

A vendor whose CLI is not on PATH and whose config directory does not exist yet
is skipped automatically (Claude: not found -> skipped rather than failing the
whole install; Codex/Gemini: nothing is created for an account nobody has).
Already-registered state for a vendor is always kept in sync, whether or not
its CLI happens to be present right now.

With a non-default --home, --bindir and --claude-bin must be given explicitly.`

function parseArgs(argv) {
  const opts = {
    replaceClaude: false,
    dryRun: false,
    rollback: false,
    skipKitTests: false,
    skipClaude: false,
    skipCodex: false,
    skipGemini: false,
    help: false
  }
  opts.claudeConfigDirs = []
  const valued = { '--source': 'source', '--home': 'home', '--bindir': 'bindir', '--claude-bin': 'claudeBin' }
  const repeated = { '--claude-config-dir': 'claudeConfigDirs' }
  const flags = {
    '--replace-claude': 'replaceClaude',
    '--dry-run': 'dryRun',
    '--rollback': 'rollback',
    '--skip-kit-tests': 'skipKitTests', // hidden: for the installer's own tests only
    '--skip-claude': 'skipClaude',
    '--skip-codex': 'skipCodex',
    '--skip-gemini': 'skipGemini',
    '--help': 'help',
    '-h': 'help'
  }
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i]
    const eq = arg.indexOf('=')
    const name = arg.startsWith('--') && eq !== -1 ? arg.slice(0, eq) : arg
    if (valued[name] || repeated[name]) {
      const value = eq !== -1 && arg.startsWith('--') ? arg.slice(eq + 1) : argv[++i]
      if (value === undefined || value === '') throw new InstallError(`${name} needs a value`)
      if (repeated[name]) opts[repeated[name]].push(value)
      else opts[valued[name]] = value
    } else if (flags[arg]) {
      opts[flags[arg]] = true
    } else {
      throw new InstallError(`unknown argument: ${arg}\n\n${HELP}`)
    }
  }
  return opts
}

// Claude Code reads skills, agents and rules only from the config directory of
// the account the session runs under — measured 2026-09-18 with a marker file in
// each directory: a session with CLAUDE_CONFIG_DIR=<dir> saw that marker and not
// the other one. One machine can therefore have several accounts, each with its
// own directory (~/.claude, ~/.claude-account-2, …), and each needs its own copy
// of the kit. Order is stable: the default directory first, then the ones asked
// for, then the environment's.
//
// Every directory must be inside the home being installed into. An explicit
// --claude-config-dir outside it is an error (the caller means a different home);
// CLAUDE_CONFIG_DIR outside it is ignored rather than fatal, because the
// installer's own tests run with a temporary --home while the real environment
// variable still points at the developer's account.
function resolveClaudeConfigDirs(opts, home) {
  // Real paths, not string prefixes: a symlink anywhere along the way would let
  // "inside the home" name a directory that is physically somewhere else, and
  // every copy below follows symlinks. The directory itself may not exist yet,
  // so resolve the nearest existing ancestor and re-attach the rest.
  const realOf = (target) => {
    let head = path.resolve(target)
    const rest = []
    for (;;) {
      if (lstatOrNull(head)) return path.join(realpathOr(head), ...rest.reverse())
      const parent = path.dirname(head)
      if (parent === head) return path.resolve(target)
      rest.push(path.basename(head))
      head = parent
    }
  }
  const realHomeDir = realOf(home)
  const inside = (dir) => {
    const real = realOf(dir)
    return real === realHomeDir || real.startsWith(realHomeDir + path.sep)
  }
  // Deduplicated by real path: two spellings of one directory (an alias symlink
  // beside it) would otherwise be installed into twice and leave the copy
  // manifest with one key holding the content and another holding nothing.
  const dirs = []
  const seen = new Set()
  const add = (dir) => {
    const real = realOf(dir)
    if (seen.has(real)) return
    seen.add(real)
    dirs.push(dir)
  }
  // The default directory is checked like any other: ~/.claude itself can be a
  // symlink pointing out of the home, and every copy below follows it.
  const preset = path.join(home, '.claude')
  if (!inside(preset)) {
    throw new InstallError(`${preset} resolves outside ${home} (${realOf(preset)}); the installer only writes inside the home it installs into`)
  }
  add(preset)
  for (const raw of opts.claudeConfigDirs || []) {
    const dir = path.resolve(raw)
    if (!inside(dir)) {
      throw new InstallError(`--claude-config-dir ${dir} is outside ${home}; the installer only writes inside the home it installs into`)
    }
    add(dir)
  }
  const fromEnv = process.env.CLAUDE_CONFIG_DIR ? path.resolve(process.env.CLAUDE_CONFIG_DIR) : null
  if (fromEnv && inside(fromEnv)) add(fromEnv)
  return dirs
}

// The boundary above is checked when the context is built; between that and the
// writes there is a build and two planning passes, so it is checked again right
// before anything is written. This narrows the window rather than closing it:
// a home an attacker can write to is already a home this installer trusts.
function assertConfigDirsInside(ctx) {
  const fresh = resolveClaudeConfigDirs({ claudeConfigDirs: ctx.claudeDirs.slice(1) }, ctx.home)
  const before = ctx.claudeDirs.join('\n')
  if (fresh.join('\n') !== before) {
    throw new InstallError(`the Claude config directories moved while installing:\n  before: ${before}\n  now:    ${fresh.join('\n          ')}`)
  }
}

function makeContext(opts) {
  const major = Number(process.versions.node.split('.')[0])
  if (!(major >= MIN_NODE_MAJOR)) throw new InstallError(`Node ${MIN_NODE_MAJOR}+ is required, this is ${process.version}`)

  const realHome = path.resolve(os.homedir())
  const home = path.resolve(opts.home || realHome)
  if (home !== realHome && (!opts.bindir || !opts.claudeBin)) {
    throw new InstallError('with a non-default --home, pass --bindir and --claude-bin explicitly (so a test never touches the real ones)')
  }
  const homeStat = lstatOrNull(home)
  if (!homeStat || !fs.statSync(home).isDirectory()) throw new InstallError(`home ${home} is not a directory`)
  const bindir = resolveBindir(opts.bindir)

  let node = null
  if (!opts.rollback) {
    node = resolveNode()
    const v = spawnSync(node.path, ['-p', 'process.versions.node'], { encoding: 'utf8', env: childEnv() })
    const nodeMajor = Number(String(v.stdout || '').trim().split('.')[0])
    if (v.error || v.status !== 0 || !(nodeMajor >= MIN_NODE_MAJOR)) {
      throw new InstallError(`${node.path} is not a working Node ${MIN_NODE_MAJOR}+ (${v.error ? v.error.message : (v.stdout || v.stderr || '').trim()})`)
    }
  }

  const kitDir = path.join(home, '.agent-kit')
  const currentPath = path.join(kitDir, 'current')
  return {
    opts,
    node,
    home,
    realHome,
    bindir,
    kitDir,
    kitDirReal: path.join(realpathOr(home), '.agent-kit'),
    releasesDir: path.join(kitDir, 'releases'),
    tmpDir: path.join(kitDir, 'tmp'),
    currentPath,
    historyPath: path.join(kitDir, 'history.jsonl'),
    lockPath: path.join(home, '.agent-kit.lock'),
    serverPath: path.join(currentPath, SERVER_REL),
    codexConfig: path.join(home, '.codex', 'config.toml'),
    geminiConfig: path.join(home, '.gemini', 'config', 'mcp_config.json'),
    claudeBin: opts.claudeBin || 'claude',
    claudeDirs: resolveClaudeConfigDirs(opts, home),
    source: path.resolve(opts.source || path.join(home, 'agent-kit'))
  }
}

// ── lock ───────────────────────────────────────────────────────────────────

function acquireLock(ctx) {
  for (let attempt = 0; attempt < 2; attempt += 1) {
    try {
      // 0o600 is a no-op on Windows (see writeFileAtomic's comment) — the
      // lock's correctness rests on 'wx' (O_CREAT|O_EXCL), which NTFS honours
      // via CreateFile(CREATE_NEW), not on the mode bits.
      const fd = fs.openSync(ctx.lockPath, 'wx', 0o600)
      fs.writeSync(fd, String(process.pid))
      fs.closeSync(fd)
      return () => fs.rmSync(ctx.lockPath, { force: true })
    } catch (error) {
      if (error.code !== 'EEXIST') throw error
      const pid = Number(fs.readFileSync(ctx.lockPath, 'utf8').trim())
      let alive = false
      try {
        // process.kill(pid, 0) is a real existence probe on Windows too (via
        // OpenProcess), but the EPERM-means-"alive, just not mine to signal"
        // fallback below encodes POSIX cross-user semantics that do not map
        // cleanly onto Windows access-denied errors. Kept as the conservative
        // default (treat as alive, never steal a lock you're unsure about) on
        // both platforms; whether Windows actually reaches this branch is for
        // CI (windows-latest) to confirm, not something asserted here.
        if (pid > 0) process.kill(pid, 0)
        alive = pid > 0
      } catch (e) {
        alive = e.code === 'EPERM'
      }
      if (alive) throw new InstallError(`another agent-kit-install is running (pid ${pid}, lock ${ctx.lockPath})`)
      fs.rmSync(ctx.lockPath, { force: true })
    }
  }
  throw new InstallError(`could not take the lock ${ctx.lockPath}`)
}

// ── source ─────────────────────────────────────────────────────────────────

function inspectSource(ctx) {
  const dir = ctx.source
  if (!lstatOrNull(dir) || !fs.statSync(dir).isDirectory()) throw new InstallError(`source ${dir} is not a directory`)
  const real = fs.realpathSync(dir)
  const top = git(real, ['rev-parse', '--show-toplevel'])
  if (top.status !== 0) throw new InstallError(`source ${dir} is not a git repository`)
  // Git for Windows can print --show-toplevel with forward slashes and/or a
  // differently-cased drive letter than fs.realpathSync returns for the same
  // directory — samePath() normalises both before comparing so that is not
  // mistaken for "not the top level".
  if (!samePath(realpathOr(top.stdout.trim()), real)) {
    throw new InstallError(`source ${dir} is inside the repository ${top.stdout.trim()} but is not its top level`)
  }
  const head = git(real, ['rev-parse', '--verify', '--quiet', 'HEAD^{commit}'])
  if (head.status !== 0 || !head.stdout.trim()) {
    throw new InstallError(`source ${dir} has no commits — commit the kit first; only committed state is installed`)
  }
  const status = git(real, ['status', '--porcelain', '--untracked-files=all', '--ignore-submodules=none'])
  if (status.status !== 0) throw new InstallError(`git status failed in ${dir}: ${status.stderr.trim()}`)
  const dirty = status.stdout.split('\n').filter(Boolean)
  if (dirty.length) {
    const shown = dirty.slice(0, 30).map((l) => `  ${l}`)
    if (dirty.length > 30) shown.push(`  … and ${dirty.length - 30} more`)
    throw new InstallError(`source ${dir} has uncommitted changes; only committed state is installed. Commit or stash:\n${shown.join('\n')}`)
  }
  const commit = head.stdout.trim()
  const tree = git(real, ['ls-tree', '-r', '--name-only', '-z', commit])
  if (tree.status !== 0) throw new InstallError(`git ls-tree failed in ${dir}: ${tree.stderr.trim()}`)
  const missing = missingPaths(tree.stdout.split('\0').filter(Boolean))
  if (missing.length) throw missingError(`commit ${commit.slice(0, 12)} of ${dir}`, missing)
  return { dir: real, commit, sha: commit.slice(0, 12) }
}

// ── manifests (content identity of a tree) ─────────────────────────────────

function manifest(root) {
  const entries = new Map()
  const walk = (rel) => {
    const abs = rel ? path.join(root, rel) : root
    for (const name of fs.readdirSync(abs).sort()) {
      const r = rel ? `${rel}/${name}` : name
      const p = path.join(root, r)
      const st = fs.lstatSync(p)
      if (st.isSymbolicLink()) entries.set(r, `link:${fs.readlinkSync(p)}`)
      else if (st.isDirectory()) {
        entries.set(r, 'dir')
        walk(r)
      } else if (st.isFile()) {
        // The executable-bit flag is meaningless on Windows (no real chmod,
        // and tar's translation of it into NTFS's read-only attribute is not
        // deterministic across separate extractions of the same commit) —
        // recording it there would risk a false "content differs" between two
        // honestly-identical copies. The content hash still catches every
        // real change; only the display flag is dropped.
        entries.set(r, `file:${!IS_WINDOWS && st.mode & 0o111 ? 'x' : '-'}:${sha256(fs.readFileSync(p))}`)
      }
      else entries.set(r, 'special')
    }
  }
  walk('')
  return entries
}

function manifestDiff(a, b, limit = 10) {
  const diff = []
  for (const [k, v] of a) if (!b.has(k)) diff.push(`- ${k}`)
    else if (b.get(k) !== v) diff.push(`~ ${k}`)
  for (const k of b.keys()) if (!a.has(k)) diff.push(`+ ${k}`)
  return diff.length > limit ? [...diff.slice(0, limit), `… ${diff.length - limit} more`] : diff
}

// ── build: archive, kit tests, smoke ───────────────────────────────────────

function tapVerdict({ status, signal, stdout }) {
  const counts = {}
  for (const m of String(stdout).matchAll(/^# (tests|suites|pass|fail|cancelled|skipped|todo) (\d+)\s*$/gm)) counts[m[1]] = Number(m[2])
  const problems = []
  if (status !== 0) problems.push(signal ? `killed by ${signal}` : `exit code ${status}`)
  for (const key of ['tests', 'fail', 'cancelled', 'skipped']) {
    if (counts[key] === undefined) problems.push(`no "# ${key}" line in the TAP summary`)
  }
  if (counts.tests === 0) problems.push('# tests 0 (nothing ran)')
  for (const key of ['fail', 'cancelled', 'skipped']) if (counts[key] > 0) problems.push(`# ${key} ${counts[key]}`)
  const failing = [...String(stdout).matchAll(/^\s*not ok \d+ - (.*)$/gm)].map((m) => m[1]).slice(0, 10)
  return { ok: problems.length === 0, counts, problems, failing }
}

function runKitTests(dir, node) {
  out('kit tests: node --test collab/test/ (in the build copy; about a minute)…')
  const started = Date.now()
  const r = spawnSync(node, ['--test', 'collab/test/'], {
    cwd: dir,
    env: childEnv(),
    encoding: 'utf8',
    maxBuffer: 256 * 1024 * 1024,
    timeout: 20 * 60 * 1000
  })
  const verdict = tapVerdict({ status: r.error ? -1 : r.status, signal: r.signal, stdout: r.stdout || '' })
  if (r.error) verdict.problems.unshift(r.error.message)
  if (!verdict.ok || r.error) {
    const logDir = fs.mkdtempSync(path.join(os.tmpdir(), 'agent-kit-tap-'))
    const log = path.join(logDir, 'kit-tests.tap')
    fs.writeFileSync(log, `${r.stdout || ''}\n--- stderr ---\n${r.stderr || ''}`)
    throw new InstallError(
      `kit tests did not pass: ${verdict.problems.join('; ')}` +
        (verdict.failing.length ? `\nfailing:\n${verdict.failing.map((f) => `  not ok - ${f}`).join('\n')}` : '') +
        `\nfull TAP log: ${log}`
    )
  }
  const seconds = Math.round((Date.now() - started) / 1000)
  out(`kit tests: ${verdict.counts.tests} tests, ${verdict.counts.pass} pass, 0 fail, 0 skipped, 0 cancelled (${seconds}s)`)
  return verdict.counts
}

function walkUpFor(start, name) {
  for (let dir = start; ; dir = path.dirname(dir)) {
    if (lstatOrNull(path.join(dir, name))) return path.join(dir, name)
    if (path.dirname(dir) === dir) return null
  }
}

function compareToolNames(expected, actual) {
  const problems = []
  if (!expected.length) problems.push('tools.mjs defines no tools')
  if (actual.length !== expected.length) problems.push(`${actual.length} tools listed, tools.mjs defines ${expected.length}`)
  const want = new Set(expected)
  const got = new Set(actual)
  const missing = expected.filter((n) => !got.has(n))
  const extra = actual.filter((n) => !want.has(n))
  const dupes = [...new Set(actual.filter((n, i) => actual.indexOf(n) !== i))]
  if (missing.length) problems.push(`missing: ${missing.join(', ')}`)
  if (extra.length) problems.push(`not in tools.mjs: ${extra.join(', ')}`)
  if (dupes.length) problems.push(`listed twice: ${dupes.join(', ')}`)
  if (want.size !== expected.length) problems.push('tools.mjs defines a name twice')
  return problems
}

// The expected tool set comes from the release being installed, read in a
// child process (cwd = the empty smoke folder, so any file it made is caught).
function releaseToolNames(node, dir, cwd) {
  const url = pathToFileURL(path.join(dir, 'collab', 'src', 'mcp', 'tools.mjs')).href
  const script = 'const m = await import(process.argv[1]); process.stdout.write(JSON.stringify((m.TOOLS || []).map((t) => t && t.name)))'
  const r = spawnSync(node, ['--input-type=module', '-e', script, url], { cwd, env: childEnv(), encoding: 'utf8', timeout: 60_000 })
  let names = null
  try {
    names = JSON.parse(r.stdout)
  } catch {
    names = null
  }
  if (r.error || r.status !== 0 || !Array.isArray(names) || names.some((n) => typeof n !== 'string')) {
    throw new InstallError(`could not read TOOLS from collab/src/mcp/tools.mjs of this release (exit ${r.status}):\n${tail(`${r.stdout}\n${r.stderr}`, 15)}`)
  }
  return names
}

function mcpHandshake(node, server, cwd, expectedNames) {
  return new Promise((resolve, reject) => {
    const child = spawn(node, [server], {
      cwd,
      env: childEnv({ COLLAB_AGENT_ID: 'claude' }),
      stdio: ['pipe', 'pipe', 'pipe']
    })
    const waiters = new Map()
    const stray = []
    let carry = ''
    let stderr = ''
    let settled = false
    const finish = (error, value) => {
      if (settled) return
      settled = true
      clearTimeout(timer)
      if (error) {
        child.kill('SIGKILL')
        error.message += stderr ? `\nserver stderr:\n${tail(stderr, 15)}` : ''
        reject(error)
      } else resolve(value)
    }
    const timer = setTimeout(() => finish(new InstallError('MCP smoke test timed out after 30s')), 30_000)
    child.on('error', (error) => finish(new InstallError(`could not start the MCP server: ${error.message}`)))
    child.stderr.setEncoding('utf8')
    child.stderr.on('data', (chunk) => {
      stderr += chunk
    })
    child.stdout.setEncoding('utf8')
    child.stdout.on('data', (chunk) => {
      carry += chunk
      for (let i = carry.indexOf('\n'); i !== -1; i = carry.indexOf('\n')) {
        const line = carry.slice(0, i)
        carry = carry.slice(i + 1)
        if (!line.trim()) continue
        let message
        try {
          message = JSON.parse(line)
        } catch {
          stray.push(line)
          continue
        }
        const waiter = waiters.get(message.id)
        if (waiter) {
          waiters.delete(message.id)
          waiter(message)
        } else stray.push(line)
      }
    })
    const exited = new Promise((res) => child.on('exit', (code, signal) => res({ code, signal })))
    child.on('exit', (code, signal) => {
      if (waiters.size) finish(new InstallError(`the MCP server exited (code ${code}, signal ${signal}) before answering`))
    })
    const send = (message) => child.stdin.write(`${JSON.stringify({ jsonrpc: '2.0', ...message })}\n`)
    const request = (id, method, params) =>
      new Promise((res) => {
        waiters.set(id, res)
        send({ id, method, params })
      })

    ;(async () => {
      const init = await request(1, 'initialize', {
        protocolVersion: '2025-06-18',
        capabilities: {},
        clientInfo: { name: 'agent-kit-install', version: '1.0.0' }
      })
      if (init.error || init.result?.serverInfo?.name !== 'collab') {
        throw new InstallError(`initialize did not return serverInfo.name "collab": ${JSON.stringify(init)}`)
      }
      send({ method: 'notifications/initialized' })
      const list = await request(2, 'tools/list', {})
      const tools = list.result?.tools
      if (!Array.isArray(tools)) throw new InstallError(`tools/list returned no tools array: ${JSON.stringify(list).slice(0, 300)}`)
      const mismatch = compareToolNames(expectedNames, tools.map((t) => t?.name))
      if (mismatch.length) {
        throw new InstallError(`tools/list does not match collab/src/mcp/tools.mjs of this release: ${mismatch.join('; ')}`)
      }
      const call = await request(3, 'tools/call', { name: 'whoami', arguments: {} })
      const text = (call.result?.content || []).map((c) => c.text || '').join('\n')
      let code = null
      try {
        code = JSON.parse(text).code
      } catch {
        code = null
      }
      if (call.result?.isError !== true || code !== 'NOT_INITIALIZED') {
        throw new InstallError(`whoami in a folder without a journal should fail with NOT_INITIALIZED, got: ${JSON.stringify(call).slice(0, 400)}`)
      }
      child.stdin.end()
      const exit = await Promise.race([exited, new Promise((res) => setTimeout(() => res(null), 5000))])
      if (!exit) throw new InstallError('the MCP server did not exit within 5s after stdin closed')
      if (stray.length) {
        throw new InstallError(`the MCP server wrote unexpected stdout lines (a reply to a notification, or a log line): ${stray.slice(0, 3).join(' | ')}`)
      }
      return { tools: tools.length, code, exit }
    })().then(
      (value) => finish(null, value),
      (error) => finish(error instanceof InstallError ? error : new InstallError(error.message))
    )
  })
}

async function smoke(dir, node) {
  const empty = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'agent-kit-smoke-')))
  try {
    if (git(empty, ['rev-parse', '--git-dir']).status === 0) throw new InstallError(`smoke folder ${empty} is inside a git repository`)
    const journal = walkUpFor(empty, '.collab')
    if (journal) throw new InstallError(`smoke folder ${empty} has a .collab above it (${journal}); set TMPDIR elsewhere`)

    // Always through `node`, never by executing bin/collab directly: that file
    // has no extension and relies on its shebang to be runnable at all, which
    // Windows cannot do. Invoking it as an argument to node is strictly more
    // portable than exec-by-shebang and changes nothing on POSIX.
    const check = spawnSync(node, [path.join(dir, 'bin', 'collab'), 'check-config'], { cwd: empty, env: childEnv(), encoding: 'utf8', timeout: 120_000 })
    if (check.error || check.status !== 0) {
      throw new InstallError(`bin/collab check-config failed (${check.error ? check.error.message : `exit ${check.status}`}):\n${tail(`${check.stdout}\n${check.stderr}`, 30)}`)
    }
    const expected = releaseToolNames(node, dir, empty)
    const hs = await mcpHandshake(node, path.join(dir, SERVER_REL), empty, expected)
    const left = fs.readdirSync(empty)
    if (left.length) throw new InstallError(`the smoke test left files in a folder without a journal: ${left.join(', ')}`)
    out(`smoke: check-config ok; MCP initialize + tools/list = ${hs.tools} tools, same names as tools.mjs; whoami -> ${hs.code}; nothing created`)
  } finally {
    fs.rmSync(empty, { recursive: true, force: true })
  }
}

function missingPaths(files) {
  const set = new Set(files)
  return REQUIRED_PATHS.filter((rel) => !set.has(rel) && !files.some((f) => f.startsWith(`${rel}/`)))
}

const missingError = (where, missing) =>
  new InstallError(`${where} is missing required paths:\n${missing.map((m) => `  - ${m}`).join('\n')}\nCommit them to the kit and install again.`)

function checkLayout(dir) {
  const missing = REQUIRED_PATHS.filter((rel) => !lstatOrNull(path.join(dir, rel)))
  if (missing.length) throw missingError(`the build copy ${dir}`, missing)
}

// projects/<id>/ is intentionally .gitignore'd (README.md: "вне самих
// репозиториев" — trusted per-project config that must not enter this kit's
// own git history). `git archive` above therefore only carried the tracked
// projects/README.md into the build copy; every project's actual registry
// lives only in the source working tree and has to be copied in from disk,
// exactly as this repo's own README documents ("установщик читает их прямо
// с диска"). Missing this step (regression, 2026-09-15: the directory was
// gitignored without adding this copy) silently produced releases whose
// registryDir held nothing but the README — every registered project fell
// back to built-in defaults with no error, only a later `collab check-config`
// failure. Entries already present from the archive (README.md) are left
// alone rather than overwritten, though on a clean source tree they would be
// byte-identical either way.
function copyLiveProjectRegistries(sourceDir, buildDir) {
  const from = path.join(sourceDir, 'projects')
  if (!lstatOrNull(from)) return
  const to = path.join(buildDir, 'projects')
  fs.mkdirSync(to, { recursive: true })
  for (const entry of fs.readdirSync(from)) {
    const entryFrom = path.join(from, entry)
    const entryTo = path.join(to, entry)
    if (lstatOrNull(entryTo)) continue
    fs.cpSync(entryFrom, entryTo, { recursive: true })
  }
}

async function build(ctx, source, journal) {
  let parent
  if (ctx.opts.dryRun) parent = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'agent-kit-dry-')))
  else {
    ensureDir(ctx.tmpDir, journal)
    parent = ctx.tmpDir
  }
  const dir = path.join(parent, `${source.sha}-${rand()}`)
  const cleanup = () => fs.rmSync(ctx.opts.dryRun ? parent : dir, { recursive: true, force: true })
  try {
    fs.mkdirSync(dir)
    const tar = `${dir}.tar`
    const archive = git(source.dir, ['archive', '--format=tar', '-o', tar, source.commit])
    if (archive.status !== 0) throw new InstallError(`git archive failed: ${archive.stderr.trim()}`)
    const x = spawnSync(TAR, ['-xf', tar, '-C', dir], { encoding: 'utf8', env: gitEnv() })
    fs.rmSync(tar, { force: true })
    if (x.error || x.status !== 0) throw new InstallError(`tar -x failed: ${x.error ? x.error.message : x.stderr}`)
    out(`build: git archive ${source.sha} -> ${dir}`)
    checkLayout(dir)
    copyLiveProjectRegistries(source.dir, dir)
    const before = manifest(dir)

    let counts = null
    if (ctx.opts.skipKitTests) out('kit tests: SKIPPED (--skip-kit-tests; for the installer test-suite only)')
    else counts = runKitTests(dir, ctx.node.path)
    await smoke(dir, ctx.node.path)

    const after = manifest(dir)
    const changed = manifestDiff(before, after)
    if (changed.length) throw new InstallError(`the kit tests or smoke test modified the build copy:\n  ${changed.join('\n  ')}`)
    return { dir, manifest: before, counts, cleanup }
  } catch (error) {
    cleanup()
    throw error
  }
}

// ── releases, current, history ─────────────────────────────────────────────

// A Windows junction can read back with an extended-length "\\?\" prefix
// and/or a trailing separator that a plain relative POSIX target never has;
// normalise both away before any comparison or reuse as a fresh target.
function normaliseLinkTarget(raw) {
  if (!IS_WINDOWS) return raw
  let s = raw
  if (s.startsWith('\\\\?\\')) s = s.slice(4)
  if (s.length > 3 && (s.endsWith('\\') || s.endsWith('/'))) s = s.slice(0, -1)
  return s
}

function readCurrent(ctx) {
  const st = lstatOrNull(ctx.currentPath)
  if (!st) return null
  if (!st.isSymbolicLink()) throw new InstallError(`${ctx.currentPath} exists and is not a symlink; refusing to touch it`)
  const raw = normaliseLinkTarget(fs.readlinkSync(ctx.currentPath))
  const resolved = path.isAbsolute(raw) ? path.normalize(raw) : path.resolve(path.dirname(ctx.currentPath), raw)
  if (!samePath(path.dirname(resolved), ctx.releasesDir) || !RELEASE_NAME.test(path.basename(resolved))) {
    throw new InstallError(`${ctx.currentPath} points at ${raw}, not at a release in ${ctx.releasesDir}; refusing to touch it`)
  }
  return { sha: path.basename(resolved), raw }
}

// POSIX: a relative symlink, exactly as before. Windows: a junction, which
// needs an absolute target (relative ones are resolved against process.cwd()
// by Node's own auto-detection, not against ctx.currentPath's directory) and
// an explicit 'junction' type, since a plain directory symlink would need
// admin/Developer Mode that a fresh install should never require.
function switchCurrent(ctx, sha, journal, previousRaw) {
  const target = IS_WINDOWS ? path.join(ctx.releasesDir, sha) : `releases/${sha}`
  atomicSymlink(target, ctx.currentPath, IS_WINDOWS ? 'junction' : 'dir')
  journal.add(`switched ${ctx.currentPath} to releases/${sha}`, () => {
    if (previousRaw) {
      const prevTarget = IS_WINDOWS && !path.isAbsolute(previousRaw) ? path.resolve(path.dirname(ctx.currentPath), previousRaw) : previousRaw
      atomicSymlink(prevTarget, ctx.currentPath, IS_WINDOWS ? 'junction' : 'dir')
    } else fs.rmSync(ctx.currentPath, { force: true })
  })
}

function readHistory(ctx) {
  if (!lstatOrNull(ctx.historyPath)) return []
  return fs
    .readFileSync(ctx.historyPath, 'utf8')
    .split('\n')
    .filter(Boolean)
    .map((line) => {
      try {
        return JSON.parse(line)
      } catch {
        return null
      }
    })
    .filter((e) => e && typeof e.sha === 'string')
}

function appendHistory(ctx, entry, journal) {
  const existed = lstatOrNull(ctx.historyPath)
  const size = existed ? existed.size : 0
  fs.appendFileSync(ctx.historyPath, `${JSON.stringify(entry)}\n`)
  journal.add(`appended to ${ctx.historyPath}`, () => {
    if (existed) fs.truncateSync(ctx.historyPath, size)
    else fs.rmSync(ctx.historyPath, { force: true })
  })
}

// Installs in order (rollbacks excluded). The rollback target of `sha` is the
// release installed before its latest install that still exists, so repeated
// --rollback walks further back instead of toggling.
function rollbackTarget(ctx, history, sha) {
  const seq = history.filter((e) => e.action !== 'rollback').map((e) => e.sha)
  let index = seq.lastIndexOf(sha)
  if (index === -1) index = seq.length
  for (let i = index - 1; i >= 0; i -= 1) {
    if (seq[i] !== sha && lstatOrNull(path.join(ctx.releasesDir, seq[i]))) return seq[i]
  }
  return null
}

function pruneReleases(ctx, history, current, previous) {
  const seq = history.filter((e) => e.action !== 'rollback').map((e) => e.sha)
  const newest = []
  for (let i = seq.length - 1; i >= 0; i -= 1) if (!newest.includes(seq[i])) newest.push(seq[i])
  const keep = new Set([...newest.slice(0, KEEP_RELEASES), current, previous, rollbackTarget(ctx, history, current)].filter(Boolean))
  const known = new Set(seq)
  const removed = []
  for (const name of fs.readdirSync(ctx.releasesDir).sort()) {
    if (!RELEASE_NAME.test(name) || keep.has(name) || !known.has(name)) continue
    fs.rmSync(path.join(ctx.releasesDir, name), { recursive: true, force: true })
    removed.push(name)
  }
  return removed
}

// ── user-level links ───────────────────────────────────────────────────────

// `kind` only changes behaviour on Windows (see planLinksWindows/
// applyLinksWindows below), except for `posixCopy` (see below).
// The bindir entry is the one spec whose *name*, not just its handling,
// differs: `collab` (a shebang script, symlinked and exec'd directly) on
// POSIX, `collab.cmd` (a generated shim, see cmdShimContent) on Windows,
// since Windows cannot execute an extension-less file at all.
//
// `posixCopy: true` marks the skill/agent entries that Claude Code's own
// discovery does not see when they are a symlink — confirmed 2026-09-16: a
// plain (non-symlink) directory or file under ~/.claude/skills or
// ~/.claude/agents is picked up, but codex-review, ui-review and the two
// agents, all installed as symlinks-through-`current`, were invisible to the
// `Skill` tool and the agent-type list in a live session, while every
// project-level (real-directory) skill in the same run was not. POSIX
// therefore copies these four instead of symlinking them (see
// planLinksPosix/applyLinksPosix and the "POSIX copy tracking" section
// below) — the same real-copy strategy Windows already used for agents/*.md
// because it has no admin-free file symlink, just generalised to directories
// and applied on POSIX too. `bin/collab` keeps the plain symlink: it is a
// launcher a human execs directly, not something either scanner reads.
//
// rules/orchestration.md joined the same way on 2026-09-17: the owner moved
// the user-level orchestration rule out of an unversioned ~/.claude/rules file
// into this repository. It is a copy for the same reason as the agents — it is
// something Claude Code scans, and a copy is the variant known to be picked
// up. A hand-written file already sitting there has no manifest record, so the
// first install on a machine that had one refuses until it is moved away.
//
// The same five entries are made in every Claude Code config directory
// (ctx.claudeDirs, see resolveClaudeConfigDirs): a session only reads its own.
// Everything downstream — planning, applying, the copy manifest, the "not
// created by this installer" refusal, --dry-run and rollback — keys off the
// destination path, so more directories just mean more entries in this list.
function linkSpecs(ctx) {
  const perConfigDir = (dir) => [
    { dest: path.join(dir, 'skills', 'codex-review'), rel: 'skills/codex-review', kind: 'dir', posixCopy: true },
    { dest: path.join(dir, 'skills', 'ui-review'), rel: 'skills/ui-review', kind: 'dir', posixCopy: true },
    // UX Guard (28.09.2026): the knowledge (ux-guidance, with references/) and
    // the review-only procedure for the ux_reviewer role. Platform- and
    // project-neutral, so they go to every account like the two above.
    { dest: path.join(dir, 'skills', 'ux-guidance'), rel: 'skills/ux-guidance', kind: 'dir', posixCopy: true },
    { dest: path.join(dir, 'skills', 'ux-critic-review'), rel: 'skills/ux-critic-review', kind: 'dir', posixCopy: true },
    { dest: path.join(dir, 'agents', 'implementer.md'), rel: 'agents/implementer.md', kind: 'file', posixCopy: true },
    { dest: path.join(dir, 'agents', 'verifier.md'), rel: 'agents/verifier.md', kind: 'file', posixCopy: true },
    { dest: path.join(dir, 'rules', 'orchestration.md'), rel: 'rules/orchestration.md', kind: 'file', posixCopy: true },
    // rules/modules.md joined on 20.09.2026, the same way and for the same
    // reason: module boundaries and integration are engineering rules that
    // hold in any project with modules, so they belong to the machine, not
    // to one repository's ADR — an ADR travels with its project and nowhere
    // else.
    { dest: path.join(dir, 'rules', 'modules.md'), rel: 'rules/modules.md', kind: 'file', posixCopy: true },
    // rules/terminology.md joined on 21.09.2026 by the owner's decision: every
    // task opens with a shared glossary (term -> name in code -> what is seen),
    // confirmed before any work. A day was lost on 20.09 to defects that were
    // disagreements about words, not code. Machine-level for the same reason
    // as the two above: it holds in every project.
    { dest: path.join(dir, 'rules', 'terminology.md'), rel: 'rules/terminology.md', kind: 'file', posixCopy: true },
    // rules/apple-toolchain.md joined on 25.09.2026 by the owner's decision:
    // Xcode, the simulators and the phone are one resource per machine, and
    // sessions of different projects broke each other's test runs by using
    // them at once. One regulation and one lock (bin/apple-lock) for all.
    { dest: path.join(dir, 'rules', 'apple-toolchain.md'), rel: 'rules/apple-toolchain.md', kind: 'file', posixCopy: true }
  ]
  // ctx.claudeDirs is what makeContext computed; a bare ctx (the unit tests build
  // one by hand) falls back to the single default directory.
  const dirs = ctx.claudeDirs || [path.join(ctx.home, '.claude')]
  return [
    ...dirs.flatMap(perConfigDir),
    { dest: path.join(ctx.bindir, IS_WINDOWS ? 'collab.cmd' : 'collab'), rel: 'bin/collab', kind: IS_WINDOWS ? 'cmd-shim' : 'file', posixCopy: false },
    // The machine lock for Xcode / simulators / devices — macOS only, like the
    // tools it serialises.
    ...(IS_WINDOWS ? [] : [{ dest: path.join(ctx.bindir, 'apple-lock'), rel: 'bin/apple-lock', kind: 'file', posixCopy: false }])
  ].map((spec) => ({ ...spec, target: path.join(ctx.currentPath, spec.rel) }))
}

// ── POSIX copy tracking (skill/agent entries a symlink hides, see linkSpecs) ─
//
// Ownership here is tracked by content hash in a small local manifest, the
// same idea windowsManifestPath uses for its file-kind entries — there is no
// readlinkSync to fall back on once the destination is a real directory or
// file. Deliberately a separate manifest/functions rather than reusing the
// Windows ones: this only runs on POSIX, and keeping it apart means touching
// it can never perturb the (untested on this machine — nobody here runs
// Windows) Windows code path.
function copiedFilesManifestPath(ctx) {
  return path.join(ctx.kitDir, 'posix-copies.json')
}

function readCopiedFilesManifest(ctx) {
  const p = copiedFilesManifestPath(ctx)
  if (!lstatOrNull(p)) return {}
  try {
    const data = JSON.parse(fs.readFileSync(p, 'utf8'))
    return data && typeof data === 'object' && !Array.isArray(data) ? data : {}
  } catch {
    return {}
  }
}

function writeCopiedFilesManifest(ctx, manifest_, journal) {
  const p = copiedFilesManifestPath(ctx)
  const before = lstatOrNull(p) ? fs.readFileSync(p) : null
  ensureDir(path.dirname(p), journal)
  writeFileAtomic(p, Buffer.from(`${JSON.stringify(manifest_, null, 2)}\n`, 'utf8'), 0o600)
  journal.add(`updated ${p}`, () => {
    if (before === null) fs.rmSync(p, { force: true })
    else writeFileAtomic(p, before, 0o600)
  })
}

// One hash for a whole directory tree, built from the same per-path manifest
// walk `manifest()` already uses for release-vs-build comparison — so two
// honestly-identical trees (by path, kind and content) always hash equal
// regardless of directory-read order.
function dirTreeHash(dir) {
  return sha256(Buffer.from(JSON.stringify([...manifest(dir).entries()])))
}

function readDirBuffers(dir) {
  const files = new Map()
  const walk = (rel) => {
    const abs = rel ? path.join(dir, rel) : dir
    for (const name of fs.readdirSync(abs).sort()) {
      const r = rel ? `${rel}/${name}` : name
      const st = fs.lstatSync(path.join(dir, r))
      if (st.isDirectory()) walk(r)
      else if (st.isFile()) files.set(r, fs.readFileSync(path.join(dir, r)))
    }
  }
  walk('')
  return files
}

function writeDirBuffers(dir, files) {
  fs.rmSync(dir, { recursive: true, force: true })
  fs.mkdirSync(dir, { recursive: true })
  for (const [rel, buf] of files) {
    const p = path.join(dir, rel)
    fs.mkdirSync(path.dirname(p), { recursive: true })
    fs.writeFileSync(p, buf)
  }
}

// Atomically makes `dest` a byte-identical copy of `source` (recursive tree).
// Builds the new tree in a sibling temp directory, then swaps it into place
// with a rename-dance: POSIX rename(2) cannot replace a non-empty directory
// in one step, so the old `dest` (if any) is renamed aside first and only
// removed once the new tree is safely in its place — the same tmp-then-
// rename shape atomicSymlink uses for a plain symlink, extended to a tree.
// Undo restores from an in-memory snapshot taken before the swap: these
// trees are a couple of small text files, never large enough to make
// buffering them a real cost, and it avoids leaving an orphan backup
// directory around for the journal's undo to depend on later.
function copyDirAtomic(source, dest, journal) {
  const tmp = `${dest}.agent-kit-tmp-${process.pid}-${rand()}`
  fs.cpSync(source, tmp, { recursive: true })
  const existed = lstatOrNull(dest)
  const before = existed ? readDirBuffers(dest) : null
  const backup = existed ? `${dest}.agent-kit-backup-${process.pid}-${rand()}` : null
  try {
    if (backup) fs.renameSync(dest, backup)
    fs.renameSync(tmp, dest)
  } catch (error) {
    fs.rmSync(tmp, { recursive: true, force: true })
    if (backup && lstatOrNull(backup) && !lstatOrNull(dest)) fs.renameSync(backup, dest)
    throw error
  }
  if (backup) fs.rmSync(backup, { recursive: true, force: true })
  journal.add(`copied ${source} -> ${dest}`, () => {
    if (before === null) fs.rmSync(dest, { recursive: true, force: true })
    else writeDirBuffers(dest, before)
  })
}

function planLinksPosix(ctx) {
  const manifest_ = readCopiedFilesManifest(ctx)
  const plan = []
  const refused = []
  for (const spec of linkSpecs(ctx)) {
    const parent = lstatOrNull(path.dirname(spec.dest))
    if (parent && !fs.statSync(path.dirname(spec.dest)).isDirectory()) {
      refused.push(`${path.dirname(spec.dest)} exists and is not a directory`)
      continue
    }
    if (spec.posixCopy) {
      const st = lstatOrNull(spec.dest)
      if (!st) {
        plan.push({ ...spec, action: 'create' })
        continue
      }
      if (st.isSymbolicLink()) {
        // A machine that already ran an older agent-kit-install has exactly
        // this as a real symlink-through-`current` (the mechanism this spec
        // replaces, see linkSpecs' posixCopy comment) — recognised the same
        // way the plain-symlink branch below recognises "ours": it resolves
        // inside this kit's own directory. That is safe to replace with a
        // real copy, not a foreign conflict to refuse.
        const raw = fs.readlinkSync(spec.dest)
        const resolved = path.resolve(path.dirname(spec.dest), raw)
        if (isInside(resolved, ctx.kitDir) || isInside(resolved, ctx.kitDirReal)) {
          plan.push({ ...spec, action: 'migrate' })
          continue
        }
        refused.push(`${spec.dest} is a symlink to ${raw}, which is not inside ${ctx.kitDir}`)
        continue
      }
      const wantsDir = spec.kind === 'dir'
      if (wantsDir ? !st.isDirectory() : !st.isFile()) {
        refused.push(`${spec.dest} exists and is a ${describeEntry(st)}, not a ${wantsDir ? 'directory' : 'file'} agent-kit manages`)
        continue
      }
      const onDiskHash = wantsDir ? dirTreeHash(spec.dest) : sha256(fs.readFileSync(spec.dest))
      if (manifest_[spec.dest] !== onDiskHash) {
        refused.push(`${spec.dest} exists and was not created by this installer (no matching record in ${copiedFilesManifestPath(ctx)})`)
        continue
      }
      // Whether a refresh is actually needed is decided in applyLinksPosix,
      // reading `target` fresh — at this point (see the "action ordering"
      // note above applyLinksPosix) `current` may still be the release this
      // install/rollback is about to LEAVE, not the one it is switching to.
      plan.push({ ...spec, action: 'manage' })
      continue
    }
    const st = lstatOrNull(spec.dest)
    if (!st) {
      plan.push({ ...spec, action: 'create' })
      continue
    }
    if (!st.isSymbolicLink()) {
      refused.push(`${spec.dest} exists and is a ${describeEntry(st)}, not an agent-kit symlink`)
      continue
    }
    const raw = fs.readlinkSync(spec.dest)
    const resolved = path.resolve(path.dirname(spec.dest), raw)
    if (resolved === spec.target) plan.push({ ...spec, action: 'ok', old: raw })
    else if (isInside(resolved, ctx.kitDir) || isInside(resolved, ctx.kitDirReal)) plan.push({ ...spec, action: 'repoint', old: raw })
    else refused.push(`${spec.dest} is a symlink to ${raw}, which is not inside ${ctx.kitDir}`)
  }
  if (refused.length) {
    throw new InstallError(
      `refusing to overwrite files that agent-kit did not create:\n  - ${refused.join('\n  - ')}\n` +
        'Move them away (or delete them) yourself and run the installer again.'
    )
  }
  return plan
}

// Order matters for the `posixCopy` items: both install() and rollback() run
// switchCurrent() BEFORE calling this (applyLinks), even though their `plan`
// was computed before that switch (planAll's second, "authoritative" call
// happens pre-switch too — see its own comment). A copy spec's `target`
// resolves through `ctx.currentPath`, so reading it INSIDE this function —
// never captured onto the plan item during planning — is what makes it see
// the release being switched TO, not the one being left. Since 2026-09-17
// the Windows file-kind copy reads at apply time for the same reason (see
// planLinksWindows); only its cmd-shim, generated from ctx and naming no
// release, is still built during planning.
function applyLinksPosix(ctx, plan, journal, changes) {
  const manifest_ = readCopiedFilesManifest(ctx)
  let manifestChanged = false
  for (const item of plan) {
    if (item.posixCopy) {
      // --rollback can switch `current` to a release older than one of these
      // entries (rules/orchestration.md joined on 2026-09-17). There is nothing
      // to copy from, and reading it would throw and undo the whole rollback —
      // so the copy already in place is kept as it is, and said so. Removing
      // it instead would leave every session without the rule at all.
      if (!lstatOrNull(item.target)) {
        changes.push(`kept ${item.dest} as it is: ${item.rel} does not exist in this release`)
        continue
      }
      ensureDir(path.dirname(item.dest), journal)
      const st = lstatOrNull(item.dest)
      // A symlink here (item.action === 'migrate', see planLinksPosix) is an
      // older install's real link-through-`current` — reading it, via
      // readFileSync/readdirSync, transparently follows it to the very same
      // content this copy would write, so the plain content-hash comparison
      // below would see no difference and skip the write, leaving the
      // symlink in place forever. `isSymlink` forces the copy regardless of
      // that match: the point of a migration is eliminating the symlink
      // itself, not just its content.
      const isSymlink = st ? st.isSymbolicLink() : false
      const existed = st && !isSymlink
      if (item.kind === 'dir') {
        const sourceHash = dirTreeHash(item.target)
        const destHash = existed ? dirTreeHash(item.dest) : null
        if (isSymlink || sourceHash !== destHash) {
          copyDirAtomic(item.target, item.dest, journal)
          changes.push(`copy ${item.dest} <- ${item.target} (${isSymlink ? 'migrated from a symlink' : existed ? 'refreshed' : 'created'})`)
          manifest_[item.dest] = sourceHash
          manifestChanged = true
        }
      } else {
        const content = fs.readFileSync(item.target)
        const sourceHash = sha256(content)
        const destHash = existed ? sha256(fs.readFileSync(item.dest)) : null
        if (isSymlink || sourceHash !== destHash) {
          // Followed through the symlink when migrating — an in-memory
          // snapshot of what it exposed today, not the link itself; undo
          // restores a content-equivalent real file, not the old symlink
          // (see copyDirAtomic's own comment for the same tradeoff).
          const beforeContent = st ? fs.readFileSync(item.dest) : null
          writeFileAtomic(item.dest, content, 0o644)
          journal.add(`wrote ${item.dest}`, () => {
            if (beforeContent === null) fs.rmSync(item.dest, { force: true })
            else writeFileAtomic(item.dest, beforeContent, 0o644)
          })
          changes.push(`copy ${item.dest} <- ${item.target} (${isSymlink ? 'migrated from a symlink' : existed ? 'refreshed' : 'created'})`)
          manifest_[item.dest] = sourceHash
          manifestChanged = true
        }
      }
      continue
    }
    if (item.action === 'create') {
      ensureDir(path.dirname(item.dest), journal)
      fs.symlinkSync(item.target, item.dest)
      journal.add(`created link ${item.dest}`, () => {
        const st = lstatOrNull(item.dest)
        if (st && st.isSymbolicLink() && fs.readlinkSync(item.dest) === item.target) fs.unlinkSync(item.dest)
      })
      changes.push(`link ${item.dest} -> ${item.target} (created)`)
    } else if (item.action === 'repoint') {
      const st = lstatOrNull(item.dest)
      if (!st || !st.isSymbolicLink() || fs.readlinkSync(item.dest) !== item.old) {
        throw new InstallError(`${item.dest} changed while the installer was running`)
      }
      atomicSymlink(item.target, item.dest)
      journal.add(`repointed link ${item.dest}`, () => atomicSymlink(item.old, item.dest))
      changes.push(`link ${item.dest} -> ${item.target} (was ${item.old})`)
    }
  }
  if (manifestChanged) writeCopiedFilesManifest(ctx, manifest_, journal)
}

// ── Windows link strategy ───────────────────────────────────────────────────
// Three different mechanisms behind one plan/apply pair, because Windows has
// no single equivalent of "a symlink, POSIX ignores the type":
//   dir       skill folders: a junction (fs.symlinkSync(..., 'junction')) —
//             the one link-like primitive Windows grants without admin/
//             Developer Mode, but only for directories and only with an
//             absolute target (see switchCurrent's comment above).
//   file      agents/*.md: junctions do not exist for files, and a real file
//             symlink needs elevation we should not require silently — so
//             these are plain copies, tracked by content hash in a small
//             local manifest so a later run can tell "ours, safe to refresh"
//             from "someone else's file, refuse" without readlinkSync.
//   cmd-shim  bin/collab at bindir: not just content but a *command* — a
//             generated .cmd that shells out to `node`, tracked in the same
//             manifest as the file kind. Its content only ever names
//             ctx.currentPath, never a specific release, so — unlike every
//             other kind — it never needs to change across an install or
//             rollback once created.
function windowsManifestPath(ctx) {
  return path.join(ctx.kitDir, 'windows-links.json')
}

function readWindowsManifest(ctx) {
  const p = windowsManifestPath(ctx)
  if (!lstatOrNull(p)) return {}
  try {
    const data = JSON.parse(fs.readFileSync(p, 'utf8'))
    return data && typeof data === 'object' && !Array.isArray(data) ? data : {}
  } catch {
    return {}
  }
}

function writeWindowsManifest(ctx, manifest, journal) {
  const p = windowsManifestPath(ctx)
  const before = lstatOrNull(p) ? fs.readFileSync(p) : null
  ensureDir(path.dirname(p), journal)
  writeFileAtomic(p, Buffer.from(`${JSON.stringify(manifest, null, 2)}\n`, 'utf8'), 0o600)
  journal.add(`updated ${p}`, () => {
    if (before === null) fs.rmSync(p, { force: true })
    else writeFileAtomic(p, before, 0o600)
  })
}

function cmdShimContent(ctx) {
  const cli = path.join(ctx.currentPath, 'bin', 'collab')
  // Bare `node`, not an absolute path: the official Windows installer puts
  // node on PATH, and a bare name means this file never goes stale if Node is
  // reinstalled elsewhere — unlike the MCP registrations, which do pin an
  // absolute node path, this is a launcher a human runs interactively.
  return Buffer.from(`@echo off\r\nnode "${cli}" %*\r\n`, 'utf8')
}

function desiredWindowsContent(ctx, spec) {
  return spec.kind === 'cmd-shim' ? cmdShimContent(ctx) : fs.readFileSync(spec.target)
}

function planLinksWindows(ctx) {
  const manifest = readWindowsManifest(ctx)
  const plan = []
  const refused = []
  for (const spec of linkSpecs(ctx)) {
    const parentDir = path.dirname(spec.dest)
    const parent = lstatOrNull(parentDir)
    if (parent && !fs.statSync(parentDir).isDirectory()) {
      refused.push(`${parentDir} exists and is not a directory`)
      continue
    }
    if (spec.kind === 'dir') {
      const st = lstatOrNull(spec.dest)
      if (!st) {
        plan.push({ ...spec, action: 'create' })
        continue
      }
      if (!st.isSymbolicLink()) {
        refused.push(`${spec.dest} exists and is a ${describeEntry(st)}, not an agent-kit link`)
        continue
      }
      const raw = normaliseLinkTarget(fs.readlinkSync(spec.dest))
      const resolved = path.isAbsolute(raw) ? path.normalize(raw) : path.resolve(path.dirname(spec.dest), raw)
      if (samePath(resolved, spec.target)) plan.push({ ...spec, action: 'ok', old: raw })
      else if (isInside(resolved, ctx.kitDir) || isInside(resolved, ctx.kitDirReal)) plan.push({ ...spec, action: 'repoint', old: raw })
      else refused.push(`${spec.dest} is a link to ${raw}, which is not inside ${ctx.kitDir}`)
      continue
    }
    // file / cmd-shim: identity is tracked by content hash in the manifest,
    // not by readlinkSync — there is no link to read.
    //
    // Planning runs BEFORE switchCurrent (see planAll's callers), so a copied
    // file's source is the release being LEFT, not the one being installed.
    // Reading it here was wrong twice over: on a first install (no `current`)
    // or an upgrade from a release older than the entry (rules/
    // orchestration.md, 2026-09-17) it threw ENOENT and refused the install
    // outright, and on an ordinary upgrade it captured the OLD release's
    // bytes and copied those, leaving the destination one release behind.
    // `content: null` defers the read to applyLinksWindows, which runs after
    // the switch — exactly where applyLinksPosix has always read its source.
    // A cmd-shim is generated from ctx, names no release and stays eager.
    const want = spec.kind === 'cmd-shim' ? desiredWindowsContent(ctx, spec) : null
    const wantHash = want ? sha256(want) : null
    const st = lstatOrNull(spec.dest)
    if (!st) {
      plan.push({ ...spec, action: 'create', content: want, hash: wantHash })
      continue
    }
    if (!st.isFile()) {
      refused.push(`${spec.dest} exists and is a ${describeEntry(st)}, not a file agent-kit manages`)
      continue
    }
    const onDiskHash = sha256(fs.readFileSync(spec.dest))
    if (manifest[spec.dest] !== onDiskHash) {
      refused.push(`${spec.dest} exists and was not created by this installer (no matching record in ${windowsManifestPath(ctx)})`)
      continue
    }
    // An unread source (wantHash null) cannot be compared yet: plan the write
    // and let apply, which has the real content, skip an identical file.
    plan.push({ ...spec, action: wantHash && onDiskHash === wantHash ? 'ok' : 'update', content: want, hash: wantHash })
  }
  if (refused.length) {
    throw new InstallError(
      `refusing to overwrite files that agent-kit did not create:\n  - ${refused.join('\n  - ')}\n` +
        'Move them away (or delete them) yourself and run the installer again.'
    )
  }
  return plan
}

function applyLinksWindows(ctx, plan, journal, changes) {
  const manifest = readWindowsManifest(ctx)
  let manifestChanged = false
  for (const item of plan) {
    if (item.kind === 'dir') {
      if (item.action === 'create') {
        ensureDir(path.dirname(item.dest), journal)
        atomicSymlink(item.target, item.dest, 'junction')
        journal.add(`created link ${item.dest}`, () => fs.rmSync(item.dest, { force: true }))
        changes.push(`link ${item.dest} -> ${item.target} (created)`)
      } else if (item.action === 'repoint') {
        const st = lstatOrNull(item.dest)
        if (!st || !st.isSymbolicLink()) throw new InstallError(`${item.dest} changed while the installer was running`)
        atomicSymlink(item.target, item.dest, 'junction')
        journal.add(`repointed link ${item.dest}`, () => atomicSymlink(item.old, item.dest, 'junction'))
        changes.push(`link ${item.dest} -> ${item.target} (was ${item.old})`)
      }
      continue
    }
    if (item.action === 'create' || item.action === 'update') {
      // content === null: every copied file's source is read here rather than
      // at plan time (see planLinksWindows) — readable or not back then, the
      // release it belongs to was still the one being left. `current` has been
      // switched by now, so read it here; a release that does not carry this
      // entry at all — a rollback
      // to one older than it — leaves the installed copy alone rather than
      // failing the run or deleting the file every session reads.
      let { content, hash } = item
      if (content === null) {
        if (!lstatOrNull(item.target)) {
          changes.push(`kept ${item.dest} as it is: ${item.rel} does not exist in this release`)
          continue
        }
        content = desiredWindowsContent(ctx, item)
        hash = sha256(content)
        const onDisk = lstatOrNull(item.dest) ? fs.readFileSync(item.dest) : null
        if (onDisk && sha256(onDisk) === hash) {
          if (manifest[item.dest] !== hash) {
            manifest[item.dest] = hash
            manifestChanged = true
          }
          continue
        }
      }
      ensureDir(path.dirname(item.dest), journal)
      const before = lstatOrNull(item.dest) ? fs.readFileSync(item.dest) : null
      writeFileAtomic(item.dest, content, 0o644)
      journal.add(`wrote ${item.dest}`, () => {
        if (before === null) fs.rmSync(item.dest, { force: true })
        else writeFileAtomic(item.dest, before, 0o644)
      })
      manifest[item.dest] = hash
      manifestChanged = true
      changes.push(`${item.kind === 'cmd-shim' ? 'shim' : 'copy'} ${item.dest} (${before === null ? 'created' : 'updated'})`)
    }
  }
  if (manifestChanged) writeWindowsManifest(ctx, manifest, journal)
}

// What a dry run may honestly promise. A Windows file entry whose source is
// only read at apply time (content === null, see planLinksWindows) is planned
// as `update` because nothing can be compared yet — but apply skips a copy
// that turns out identical, so announcing a flat "update" would report a
// change that may never happen.
function plannedAction(item) {
  return item.action === 'update' && item.content === null ? 'update if it differs' : item.action
}

function planLinks(ctx) {
  return IS_WINDOWS ? planLinksWindows(ctx) : planLinksPosix(ctx)
}

function applyLinks(ctx, plan, journal, changes) {
  if (IS_WINDOWS) applyLinksWindows(ctx, plan, journal, changes)
  else applyLinksPosix(ctx, plan, journal, changes)
}

function brokenLinks(ctx) {
  return linkSpecs(ctx)
    .filter((spec) => {
      try {
        fs.statSync(spec.dest)
        return false
      } catch {
        return true
      }
    })
    .map((spec) => spec.dest)
}

// ── Codex: ~/.codex/config.toml ────────────────────────────────────────────
// Not a TOML parser. A line scanner that knows enough TOML (strings,
// multi-line strings, multi-line arrays, comments) to find table headers, so
// exactly the [mcp_servers.collab] section is replaced and every other byte is
// kept. The text is handled as latin1 so bytes round-trip whatever the encoding.

function splitLines(text) {
  const lines = []
  let i = 0
  while (i < text.length) {
    const j = text.indexOf('\n', i)
    if (j === -1) {
      lines.push({ body: text.slice(i), eol: '' })
      break
    }
    const crlf = j > i && text[j - 1] === '\r'
    lines.push({ body: text.slice(i, crlf ? j - 1 : j), eol: crlf ? '\r\n' : '\n' })
    i = j + 1
  }
  return lines
}

function normalizeKey(raw) {
  const parts = []
  let current = ''
  let quote = null
  for (const ch of raw) {
    if (quote) {
      if (ch === quote) quote = null
      else current += ch
    } else if (ch === '"' || ch === "'") quote = ch
    else if (ch === '.') {
      parts.push(current.trim())
      current = ''
    } else current += ch
  }
  parts.push(current.trim())
  return parts.join('.')
}

function classifyToml(lines) {
  let ml = null
  let depth = 0
  const closeBasic = (s, from) => {
    for (let j = s.indexOf('"""', from); j !== -1; j = s.indexOf('"""', j + 1)) {
      let backslashes = 0
      for (let k = j - 1; k >= 0 && s[k] === '\\'; k -= 1) backslashes += 1
      if (backslashes % 2 === 0) return j
    }
    return -1
  }
  const scan = (s, start) => {
    let i = start
    while (i < s.length) {
      if (ml) {
        const close = ml === '"""' ? closeBasic(s, i) : s.indexOf("'''", i)
        if (close === -1) return
        i = close + 3
        while (s[i] === ml[0]) i += 1
        ml = null
        continue
      }
      const ch = s[i]
      if (ch === '#') return
      if (s.startsWith('"""', i) || s.startsWith("'''", i)) {
        ml = s.slice(i, i + 3)
        i += 3
        continue
      }
      if (ch === '"') {
        i += 1
        while (i < s.length && s[i] !== '"') i += s[i] === '\\' ? 2 : 1
        i += 1
        continue
      }
      if (ch === "'") {
        const j = s.indexOf("'", i + 1)
        i = j === -1 ? s.length : j + 1
        continue
      }
      if (ch === '[' || ch === '{') depth += 1
      else if (ch === ']' || ch === '}') depth = Math.max(0, depth - 1)
      i += 1
    }
  }
  const findEq = (s) => {
    let quote = null
    for (let i = 0; i < s.length; i += 1) {
      if (quote) {
        if (s[i] === quote) quote = null
      } else if (s[i] === '"' || s[i] === "'") quote = s[i]
      else if (s[i] === '=') return i
    }
    return -1
  }
  return lines.map(({ body }, index) => {
    const plain = ml === null && depth === 0
    if (plain) {
      const t = body.trim()
      if (t === '' || t.startsWith('#')) return { kind: 'blank', plain }
      if (t.startsWith('[')) {
        const array = t.startsWith('[[')
        const m = array ? /^\[\[\s*(.+?)\s*\]\]\s*(#.*)?$/.exec(t) : /^\[\s*(.+?)\s*\]\s*(#.*)?$/.exec(t)
        if (!m) return { kind: 'bad', plain, line: index + 1 }
        return { kind: 'header', name: normalizeKey(m[1]), array, plain }
      }
      const eq = findEq(body)
      if (eq === -1) return { kind: 'bad', plain, line: index + 1 }
      scan(body, eq + 1)
      return { kind: 'key', key: normalizeKey(body.slice(0, eq)), plain }
    }
    scan(body, 0)
    return { kind: 'other', plain }
  })
}

const CODEX_TABLE = 'mcp_servers.collab'

function codexBlock(serverPath, nodePath) {
  return [
    `[${CODEX_TABLE}]`,
    '# Managed by agent-kit-install: the active agent-kit release, through ~/.agent-kit/current.',
    `command = ${JSON.stringify(nodePath)}`,
    `args = [${JSON.stringify(serverPath)}]`,
    'env = { COLLAB_AGENT_ID = "codex" }',
    'startup_timeout_sec = 20'
  ]
}

// text and block lines are latin1 strings. Returns { changed, text, replaced, oldBlock }.
function rewriteCodexToml(text, blockLines) {
  const lines = splitLines(text)
  const info = classifyToml(lines)
  const eol = lines.find((l) => l.eol)?.eol || '\n'
  const ours = (name) => name === CODEX_TABLE || name.startsWith(`${CODEX_TABLE}.`)
  const problems = []
  let start = -1
  let table = ''
  info.forEach((c, i) => {
    if (c.kind === 'bad') problems.push(`line ${i + 1} is neither a table header nor key = value`)
    if (c.kind === 'header') {
      table = c.name
      if (c.array && ours(c.name)) problems.push(`line ${i + 1}: [[${c.name}]] is an array of tables`)
      else if (c.name === CODEX_TABLE) {
        if (start === -1) start = i
        else problems.push(`line ${i + 1}: a second [${CODEX_TABLE}]`)
      }
    } else if (c.kind === 'key' && !ours(table)) {
      const full = table ? `${table}.${c.key}` : c.key
      if (ours(full)) problems.push(`line ${i + 1}: ${CODEX_TABLE} is defined by the key "${c.key}"${table ? ` in [${table}]` : ''}`)
    }
  })
  let end = lines.length
  if (start !== -1) {
    for (let i = start + 1; i < lines.length; i += 1) {
      if (info[i].kind === 'header' && !ours(info[i].name)) {
        end = i
        break
      }
    }
  }
  info.forEach((c, i) => {
    if (c.kind === 'header' && ours(c.name) && c.name !== CODEX_TABLE && (start === -1 || i < start || i >= end)) {
      problems.push(`line ${i + 1}: [${c.name}] is not directly under [${CODEX_TABLE}]`)
    }
  })
  if (problems.length) {
    const error = new Error(problems.join('; '))
    error.problems = problems
    throw error
  }

  if (start !== -1) {
    // Blank and comment lines before the next table belong to that table.
    while (end - 1 > start && info[end - 1].kind === 'blank' && info[end - 1].plain) end -= 1
    const oldBlock = lines.slice(start, end).map((l) => l.body + l.eol).join('')
    const replacement = blockLines.join(eol) + lines[end - 1].eol
    if (oldBlock === replacement) return { changed: false, text, replaced: false, oldBlock }
    const prefix = lines.slice(0, start).map((l) => l.body + l.eol).join('')
    const suffix = lines.slice(end).map((l) => l.body + l.eol).join('')
    return { changed: true, text: prefix + replacement + suffix, replaced: true, oldBlock }
  }
  if (text === '') return { changed: true, text: blockLines.join(eol) + eol, replaced: false, oldBlock: null }
  const base = text.endsWith('\n') ? text : text + eol
  const gap = base.endsWith(eol + eol) ? '' : eol
  return { changed: true, text: base + gap + blockLines.join(eol) + eol, replaced: false, oldBlock: null }
}

function planCodex(ctx) {
  if (ctx.opts.skipCodex) return { skipped: true, reason: 'requested with --skip-codex' }
  const st = lstatOrNull(ctx.codexConfig)
  // Nothing to fix yet and no sign codex was ever set up here: do not create
  // ~/.codex out of nothing for an account nobody has. Once either exists —
  // the binary, or a config directory from some earlier setup — this keeps
  // registering exactly as before, whether or not the binary is on PATH
  // right now.
  if (!st && !commandExists('codex') && !lstatOrNull(path.dirname(ctx.codexConfig))) {
    return { skipped: true, reason: 'codex is not installed and ~/.codex does not exist yet' }
  }
  let file = ctx.codexConfig
  let original = null
  let mode = 0o600
  if (st) {
    file = fs.realpathSync(ctx.codexConfig)
    const real = fs.statSync(file)
    if (!real.isFile()) throw new InstallError(`${ctx.codexConfig} is not a regular file`)
    original = fs.readFileSync(file)
    mode = real.mode & 0o777
  }
  const block = codexBlock(ctx.serverPath, ctx.node.path).map((l) => Buffer.from(l, 'utf8').toString('latin1'))
  let result
  try {
    result = rewriteCodexToml(original ? original.toString('latin1') : '', block)
  } catch (error) {
    throw new InstallError(`cannot safely rewrite ${ctx.codexConfig}: ${error.message}. Fix the [${CODEX_TABLE}] entry by hand.`)
  }
  return {
    file,
    viaLink: st?.isSymbolicLink() ? ctx.codexConfig : null,
    exists: Boolean(st),
    original,
    mode,
    next: Buffer.from(result.text, 'latin1'),
    changed: result.changed,
    replaced: result.replaced,
    oldBlock: result.oldBlock ? Buffer.from(result.oldBlock, 'latin1').toString('utf8') : null
  }
}

function applyCodex(ctx, plan, journal, changes) {
  if (!plan.changed) return
  if (plan.exists) {
    const now = fs.readFileSync(plan.file)
    if (!now.equals(plan.original)) throw new InstallError(`${plan.file} changed while the installer was running`)
    const backup = `${plan.file}.backup-${new Date().toISOString().replace(/[:.]/g, '-')}`
    fs.copyFileSync(plan.file, backup, fs.constants.COPYFILE_EXCL)
    writeFileAtomic(plan.file, plan.next, plan.mode)
    journal.add(`rewrote ${plan.file}`, () => {
      writeFileAtomic(plan.file, plan.original, plan.mode)
      fs.rmSync(backup, { force: true })
    })
    changes.push(`codex: ${plan.replaced ? 'replaced' : 'appended'} [${CODEX_TABLE}] in ${plan.file} (backup ${backup})`)
  } else {
    ensureDir(path.dirname(plan.file), journal)
    writeFileAtomic(plan.file, plan.next, 0o600)
    journal.add(`created ${plan.file}`, () => fs.rmSync(plan.file, { force: true }))
    changes.push(`codex: created ${plan.file} with [${CODEX_TABLE}]`)
  }
  if (!fs.readFileSync(plan.file).equals(plan.next)) throw new InstallError(`${plan.file} does not read back as written`)
}

function summarizeCodex(ctx, plan) {
  return plan.changed ? `codex: ${plan.exists ? (plan.replaced ? 'replace' : 'append') : 'create'} [${CODEX_TABLE}] in ${plan.file}` : null
}

function detailPlannedCodex(ctx, plan) {
  return plan.oldBlock && plan.changed ? `codex block that would be replaced:\n${plan.oldBlock}` : null
}

function detailAppliedCodex(ctx, plan) {
  return plan.replaced && plan.oldBlock ? `replaced codex block was:\n${plan.oldBlock.trimEnd()}` : null
}

// ── Claude Code: user-scope MCP registration ───────────────────────────────

function runClaude(ctx, args, configDir = null) {
  // A neutral cwd: `claude mcp get` resolves local and project scopes from it,
  // and a project's .mcp.json must not be mistaken for the user registration.
  const cwd = fs.mkdtempSync(path.join(os.tmpdir(), 'agent-kit-claude-'))
  try {
    // On Windows an npm-installed `claude` is a .cmd shim, which CreateProcess
    // refuses to launch directly (only true .exe/.com binaries qualify) —
    // shell:true routes it through cmd.exe. Node still receives `args` as an
    // array here and quotes each element itself before handing the command
    // line to cmd.exe, so this does not reopen the shell-string-injection
    // hole that keeping `args` as a plain argv array everywhere else avoids.
    // configDir: which account's settings this call reads and writes. Claude Code
    // takes it from CLAUDE_CONFIG_DIR, so one registration per directory.
    const env = childEnv(configDir ? { CLAUDE_CONFIG_DIR: configDir } : {})
    const r = spawnSync(ctx.claudeBin, args, { cwd, env, encoding: 'utf8', timeout: 120_000, shell: IS_WINDOWS })
    if (r.error) throw new InstallError(`could not run ${ctx.claudeBin} ${args.join(' ')}: ${r.error.message}`)
    return r
  } finally {
    fs.rmSync(cwd, { recursive: true, force: true })
  }
}

// Text only. The exit code of `claude mcp get` says nothing: "not found" exits 0
// too (Claude Code 2.1.270). `status` is used in error messages only.
function parseClaudeGet({ status, stdout, stderr }, name = 'collab') {
  const clean = (s) => String(s || '').replace(/\x1b\[[0-9;]*[A-Za-z]/g, '')
  const lines = clean(stdout).split(/\r?\n/)
  const header = lines.findIndex((l) => l.trim() === `${name}:`)
  if (header === -1) {
    if (/no mcp server/i.test(`${clean(stdout)}\n${clean(stderr)}`)) return { found: false }
    throw new InstallError(`could not interpret \`claude mcp get collab\` (exit ${status}):\n${tail(`${clean(stdout)}\n${clean(stderr)}`, 15)}`)
  }
  const reg = { found: true, scope: null, scopeLabel: null, type: null, command: null, args: null, env: {} }
  let inEnv = false
  for (const line of lines.slice(header + 1)) {
    const field = /^ {2}(\w[\w ]*?): ?(.*)$/.exec(line)
    const envLine = /^ {4}([^=\s][^=]*)=(.*)$/.exec(line)
    if (inEnv && envLine) {
      reg.env[envLine[1]] = envLine[2]
      continue
    }
    inEnv = false
    if (field) {
      const [, key, value] = field
      if (key === 'Scope') {
        reg.scopeLabel = value.trim()
        reg.scope = /^user/i.test(reg.scopeLabel) ? 'user' : 'other'
      } else if (key === 'Type') reg.type = value.trim()
      else if (key === 'Command') reg.command = value.trim()
      else if (key === 'Args') reg.args = value.trim()
      else if (key === 'Environment') inEnv = true
      continue
    }
  }
  return reg
}

function claudeMatches(ctx, reg) {
  return (
    reg.found &&
    reg.scope === 'user' &&
    (reg.type === null || reg.type === 'stdio') &&
    reg.command === ctx.node.path &&
    reg.args === ctx.serverPath &&
    Object.keys(reg.env).length === 1 &&
    reg.env.COLLAB_AGENT_ID === 'claude'
  )
}

const describeRegistration = (reg) =>
  `Scope: ${reg.scopeLabel || '(no Scope line)'}; ${reg.type || '?'}:${reg.command || '?'} ${reg.args || ''}; env ${
    Object.entries(reg.env)
      .map(([k, v]) => `${k}=${v}`)
      .join(' ') || '(none)'
  }`

// One plan per config directory (ctx.claudeDirs). A directory whose CLI call
// fails — a disabled account answers `claude mcp get` with an error, not a
// registration — is carried as { unreachable } and reported; the copies, which
// are what the sessions actually read, are installed either way. A wrong-scope
// or conflicting registration is still fatal: that is somebody's deliberate
// configuration, and silently working around it is how state gets clobbered.
function planClaudeDir(ctx, dir) {
  let raw = null
  let reg
  try {
    raw = runClaude(ctx, ['mcp', 'get', 'collab'], dir)
    reg = parseClaudeGet(raw)
  } catch (error) {
    if (!(error instanceof InstallError)) throw error
    // What the CLI itself said is the useful part ("...subscription access disabled"),
    // not the installer's wrapper around it.
    const said = raw ? firstLine(`${raw.stderr || ''}\n${raw.stdout || ''}`.trim()) : ''
    return { dir, unreachable: said || firstLine(error.message) }
  }
  if (!reg.found) return { dir, action: 'add', existing: null }
  if (reg.scope !== 'user') {
    throw new InstallError(
      `\`claude mcp get collab\` (run from a neutral directory, CLAUDE_CONFIG_DIR=${dir}) shows "collab" with Scope: ${reg.scopeLabel || '(no Scope line)'}\n` +
        'That is not user scope, so the installer will not touch it, not even with --replace-claude. Remove it yourself first.'
    )
  }
  if (claudeMatches(ctx, reg)) return { dir, action: 'ok', existing: reg }
  if (!ctx.opts.replaceClaude) {
    throw new InstallError(
      `a different user-scope "collab" MCP server is registered with Claude Code in ${dir} (${describeRegistration(reg)}).\n` +
        `Expected: ${ctx.node.path} ${ctx.serverPath}; env COLLAB_AGENT_ID=claude. Re-run with --replace-claude to replace it.`
    )
  }
  return { dir, action: 'replace', existing: reg }
}

function planClaude(ctx) {
  if (ctx.opts.skipClaude) return { skipped: true, reason: 'requested with --skip-claude' }
  // Unlike Codex/Gemini, there is no plain file to fall back to checking:
  // reading Claude's registration means running its binary. Not on PATH is a
  // reason to skip, not to fail the whole install over a vendor the caller
  // may not even use.
  if (!commandExists(ctx.claudeBin)) return { skipped: true, reason: `${ctx.claudeBin} not found on PATH` }
  return { dirs: ctx.claudeDirs.map((dir) => planClaudeDir(ctx, dir)) }
}

function claudeAddArgs(ctx) {
  return ['mcp', 'add', '-s', 'user', 'collab', '-e', 'COLLAB_AGENT_ID=claude', '--', ctx.node.path, ctx.serverPath]
}

// With one config directory the wording stays exactly as it was; the directory
// is named only when there is more than one and the reader needs to know which.
const claudeLabel = (ctx, dir) => ((ctx.claudeDirs || []).length > 1 ? `claude (${dir})` : 'claude')

function applyClaudeDir(ctx, item, journal, changes) {
  const { dir } = item
  if (item.unreachable) {
    changes.push(`${claudeLabel(ctx, dir)}: NOT registered — ${item.unreachable}; the copies are installed, register by hand when the account works again`)
    return
  }
  if (item.action === 'ok') return
  if (item.action === 'replace') {
    const old = item.existing
    const removed = runClaude(ctx, ['mcp', 'remove', '-s', 'user', 'collab'], dir)
    if (removed.status !== 0) throw new InstallError(`claude mcp remove -s user collab (CLAUDE_CONFIG_DIR=${dir}) failed:\n${tail(removed.stdout + removed.stderr, 10)}`)
    journal.add(`removed the previous user-scope collab registration in ${dir} (re-added best effort; args are split on spaces)`, () => {
      const envArgs = Object.entries(old.env).flatMap(([k, v]) => ['-e', `${k}=${v}`])
      const r = runClaude(ctx, ['mcp', 'add', '-s', 'user', 'collab', ...envArgs, '--', old.command, ...(old.args ? old.args.split(' ') : [])], dir)
      if (r.status !== 0) throw new Error(`re-adding failed: ${tail(r.stdout + r.stderr, 5)}`)
    })
  }
  const added = runClaude(ctx, claudeAddArgs(ctx), dir)
  if (added.status !== 0) throw new InstallError(`claude ${claudeAddArgs(ctx).join(' ')} (CLAUDE_CONFIG_DIR=${dir}) failed:\n${tail(added.stdout + added.stderr, 10)}`)
  journal.add(`registered collab with Claude Code (user scope) in ${dir}`, () => {
    const r = runClaude(ctx, ['mcp', 'remove', '-s', 'user', 'collab'], dir)
    if (r.status !== 0) throw new Error(tail(r.stdout + r.stderr, 5))
  })
  const check = parseClaudeGet(runClaude(ctx, ['mcp', 'get', 'collab'], dir))
  if (!claudeMatches(ctx, check)) {
    throw new InstallError(`after claude mcp add (CLAUDE_CONFIG_DIR=${dir}), \`claude mcp get collab\` does not show the expected registration: ${check.found ? describeRegistration(check) : 'not found'}`)
  }
  changes.push(
    `${claudeLabel(ctx, dir)}: ${item.action === 'replace' ? `replaced (${describeRegistration(item.existing)}) with` : 'registered'} user-scope collab -> ${ctx.node.path} ${ctx.serverPath}`
  )
}

// The first directory is the one a plain `claude` uses; a failure there is the
// old fatal error (and the installer rolls back). For the extra accounts a
// failure is reported and the install stands: their copies — which is what a
// session reads — are already in place, and one broken account must not undo
// an install for all the others.
function applyClaude(ctx, plan, journal, changes) {
  const [primary] = ctx.claudeDirs
  for (const item of plan.dirs) {
    if (item.dir === primary) {
      applyClaudeDir(ctx, item, journal, changes)
      continue
    }
    try {
      applyClaudeDir(ctx, item, journal, changes)
    } catch (error) {
      // A failed 'replace' has already removed the old registration; swallowing
      // that would leave the account with nothing. Only a plain 'add', which
      // has changed nothing yet, degrades to a warning.
      if (!(error instanceof InstallError) || item.action === 'replace') throw error
      changes.push(`${claudeLabel(ctx, item.dir)}: NOT registered — ${firstLine(error.message)}; the copies are installed, register by hand`)
    }
  }
}

function summarizeClaude(ctx, plan) {
  return plan.dirs
    .filter((item) => item.unreachable || item.action !== 'ok')
    .map((item) =>
      item.unreachable
        ? `${claudeLabel(ctx, item.dir)}: cannot register — ${item.unreachable}`
        : `${claudeLabel(ctx, item.dir)}: ${item.action} user-scope collab -> ${ctx.node.path} ${ctx.serverPath}`
    )
}

// ── Gemini (Google's Antigravity CLI, `agy`): ~/.gemini/config/mcp_config.json
// The npm package `@google/gemini-cli` this used to target is gone: Google cut
// free/Pro/Ultra individual access to it on 2026-06-18 and pointed everyone at
// Antigravity CLI instead — a different, closed-source binary. Confirmed live
// on this machine (agy 1.1.8, `brew install --cask antigravity-cli`): `agy mcp
// add` writes exactly this file, in exactly this shape, and a real headless
// call (`agy -p ... --model gemini-3.6-flash-low`) reached collab's `whoami`
// through it. A JSON object, not TOML, so — unlike Codex — no line-scanner is
// needed: mcpServers.collab is merged in structurally and every other
// top-level key is kept exactly as parsed, never touched as text.

function geminiServerEntry(ctx) {
  return { command: ctx.node.path, args: [ctx.serverPath], env: { COLLAB_AGENT_ID: 'gemini' } }
}

// `disabled` is agy's own toggle (`agy mcp disable collab`), not ours: an
// install that ran after the owner disabled it must not silently re-enable
// what they turned off. So it is excluded from the equality check below and
// preserved verbatim from whatever is already on disk; only a fresh entry
// gets the `disabled: false` agy itself would write for a new one.
function geminiEqual(existing, desired) {
  if (!existing) return false
  const { disabled: _existingDisabled, ...existingRest } = existing
  return jsonEqual(existingRest, desired)
}

// Structural equality for the JSON-shaped values compared here (plain
// objects, arrays, strings): good enough that mcp_config.json re-saved by
// agy itself, with keys in a different order, still reads as "unchanged"
// instead of triggering a needless rewrite on the next install.
function jsonEqual(a, b) {
  if (a === b) return true
  if (typeof a !== typeof b || a === null || b === null) return false
  if (Array.isArray(a) || Array.isArray(b)) {
    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false
    return a.every((v, i) => jsonEqual(v, b[i]))
  }
  if (typeof a === 'object') {
    const ak = Object.keys(a)
    const bk = Object.keys(b)
    return ak.length === bk.length && ak.every((k) => Object.prototype.hasOwnProperty.call(b, k) && jsonEqual(a[k], b[k]))
  }
  return false
}

function planGemini(ctx) {
  if (ctx.opts.skipGemini) return { skipped: true, reason: 'requested with --skip-gemini' }
  const st = lstatOrNull(ctx.geminiConfig)
  // Same reasoning as Codex: no fresh ~/.gemini for an account nobody has.
  // Checked two levels up (~/.gemini, not ~/.gemini/config) because agy keeps
  // other state there (antigravity-cli/, settings.json) before it ever writes
  // config/mcp_config.json — that wider directory is the real "used before" signal.
  if (!st && !commandExists('agy') && !lstatOrNull(path.dirname(path.dirname(ctx.geminiConfig)))) {
    return { skipped: true, reason: 'agy (Antigravity CLI) is not installed and ~/.gemini does not exist yet' }
  }
  let file = ctx.geminiConfig
  let original = null
  let mode = 0o600
  let current = {}
  if (st) {
    file = fs.realpathSync(ctx.geminiConfig)
    const real = fs.statSync(file)
    if (!real.isFile()) throw new InstallError(`${ctx.geminiConfig} is not a regular file`)
    original = fs.readFileSync(file)
    mode = real.mode & 0o777
    try {
      current = JSON.parse(original.toString('utf8'))
    } catch (error) {
      throw new InstallError(`cannot safely merge ${ctx.geminiConfig}: it is not valid JSON (${error.message}). Fix it by hand.`)
    }
    if (current === null || typeof current !== 'object' || Array.isArray(current)) {
      throw new InstallError(`${ctx.geminiConfig} does not contain a JSON object at the top level`)
    }
  }
  const servers = current.mcpServers
  if (servers !== undefined && (servers === null || typeof servers !== 'object' || Array.isArray(servers))) {
    throw new InstallError(`${ctx.geminiConfig} has a non-object "mcpServers" key. Fix it by hand.`)
  }
  const desired = geminiServerEntry(ctx)
  const existing = servers?.collab
  const changed = !geminiEqual(existing, desired)
  const entry = existing && typeof existing.disabled === 'boolean' ? { ...desired, disabled: existing.disabled } : { ...desired, disabled: false }
  const next = { ...current, mcpServers: { ...(servers || {}), collab: entry } }
  return {
    file,
    exists: Boolean(st),
    original,
    mode,
    next: Buffer.from(`${JSON.stringify(next, null, 2)}\n`, 'utf8'),
    changed
  }
}

function applyGemini(ctx, plan, journal, changes) {
  if (!plan.changed) return
  if (plan.exists) {
    const now = fs.readFileSync(plan.file)
    if (!now.equals(plan.original)) throw new InstallError(`${plan.file} changed while the installer was running`)
    const backup = `${plan.file}.backup-${new Date().toISOString().replace(/[:.]/g, '-')}`
    fs.copyFileSync(plan.file, backup, fs.constants.COPYFILE_EXCL)
    writeFileAtomic(plan.file, plan.next, plan.mode)
    journal.add(`rewrote ${plan.file}`, () => {
      writeFileAtomic(plan.file, plan.original, plan.mode)
      fs.rmSync(backup, { force: true })
    })
    changes.push(`gemini: updated mcpServers.collab in ${plan.file} (backup ${backup})`)
  } else {
    ensureDir(path.dirname(plan.file), journal)
    writeFileAtomic(plan.file, plan.next, 0o600)
    journal.add(`created ${plan.file}`, () => fs.rmSync(plan.file, { force: true }))
    changes.push(`gemini: created ${plan.file} with mcpServers.collab`)
  }
  if (!fs.readFileSync(plan.file).equals(plan.next)) throw new InstallError(`${plan.file} does not read back as written`)
}

function summarizeGemini(ctx, plan) {
  return plan.changed ? `gemini: ${plan.exists ? 'update' : 'create'} mcpServers.collab in ${plan.file}` : null
}

// ── install ────────────────────────────────────────────────────────────────

function rollbackCommand(ctx) {
  const parts = [realpathOr(process.argv[1]), '--rollback']
  if (ctx.home !== ctx.realHome) parts.push('--home', ctx.home, '--bindir', ctx.bindir, '--claude-bin', ctx.claudeBin)
  else if (!BINDIR_CANDIDATES.includes(ctx.bindir)) parts.push('--bindir', ctx.bindir)
  // A rollback has to reach every config directory this install wrote to, and the
  // extra ones are only known from the command line (or the environment, which the
  // next run may not have).
  for (const dir of ctx.claudeDirs.slice(1)) parts.push('--claude-config-dir', dir)
  return parts.map(shellQuote).join(' ')
}

// One registrar per MCP client. plan()/apply() do the work (each defined in
// its own section above); summary()/detailPlanned()/detailApplied() build the
// installer's own output. Adding a vendor — the whole reason this is a list
// and not four separate call sites — means writing its plan/apply/summary
// functions and adding one entry here; nothing below this point knows how
// many clients there are or what they are called.
const MCP_CLIENTS = [
  { id: 'codex', plan: planCodex, apply: applyCodex, summary: summarizeCodex, detailPlanned: detailPlannedCodex, detailApplied: detailAppliedCodex },
  { id: 'claude', plan: planClaude, apply: applyClaude, summary: summarizeClaude },
  { id: 'gemini', plan: planGemini, apply: applyGemini, summary: summarizeGemini }
]

function planAll(ctx) {
  return { current: readCurrent(ctx), links: planLinks(ctx), clients: Object.fromEntries(MCP_CLIENTS.map((c) => [c.id, c.plan(ctx)])) }
}

async function install(ctx) {
  const source = inspectSource(ctx)
  out(`source: ${source.dir} at ${source.sha} (${source.commit})`)
  out(`node for registrations: ${ctx.node.path}`)
  if (ctx.node.warning) out(`warning: ${ctx.node.warning}`)
  planAll(ctx) // refuse early, before the long build

  const journal = new Journal()
  let built = null
  try {
    built = await build(ctx, source, journal)
    const plan = planAll(ctx) // authoritative: state may have moved during the build
    // Announced once, up front, then quietly excluded from every loop below —
    // a vendor with no CLI and no prior state is steady state, not a change
    // to report on every single run.
    for (const c of MCP_CLIENTS) {
      const p = plan.clients[c.id]
      if (p.skipped) out(`${c.id}: skipped — ${p.reason}`)
    }
    const previous = plan.current?.sha || null
    const releaseDir = path.join(ctx.releasesDir, source.sha)
    const existing = lstatOrNull(releaseDir)
    if (existing) {
      const diff = existing.isDirectory() ? manifestDiff(manifest(releaseDir), built.manifest) : ['not a directory']
      if (diff.length) {
        throw new InstallError(`${releaseDir} already exists with different content than commit ${source.sha}:\n  ${diff.join('\n  ')}\nRemove it and install again.`)
      }
    }

    const planned = []
    planned.push(existing ? `release ${releaseDir} (exists, identical: reuse)` : `release ${releaseDir} (new)`)
    if (previous !== source.sha) planned.push(`current -> releases/${source.sha} (was ${previous || 'none'}); history.jsonl += 1 line`)
    for (const l of plan.links) {
      if (l.action === 'ok') continue
      planned.push(
        l.posixCopy || l.content === null
          ? `copy ${l.dest} <- ${l.target} (${plannedAction(l)})`
          : `link ${l.dest} -> ${l.target} (${l.action}${l.old ? `, was ${l.old}` : ''})`
      )
    }
    for (const c of MCP_CLIENTS) {
      const p = plan.clients[c.id]
      if (p.skipped) continue
      const line = c.summary(ctx, p)
      // A client may plan more than one thing (Claude: one registration per config directory).
      if (line) planned.push(...[].concat(line))
    }

    if (ctx.opts.dryRun) {
      built.cleanup()
      out('')
      out(`DRY RUN — every check passed; nothing was changed.`)
      out(`would install ${source.sha} (commit ${source.commit}); previous: ${previous || 'none'}`)
      for (const c of MCP_CLIENTS) {
        const p = plan.clients[c.id]
        if (p.skipped) continue
        const detail = c.detailPlanned?.(ctx, p)
        if (detail) out(detail)
      }
      const effective = planned.filter((p) => !p.includes('identical: reuse'))
      out(effective.length ? `planned changes:\n${planned.map((p) => `  - ${p}`).join('\n')}` : 'planned changes: none (already installed)')
      return
    }

    const changes = []
    ensureDir(ctx.releasesDir, journal)
    if (existing) built.cleanup()
    else {
      fs.renameSync(built.dir, releaseDir)
      journal.add(`created ${releaseDir}`, () => fs.rmSync(releaseDir, { recursive: true, force: true }))
      changes.push(`release ${releaseDir} created`)
    }
    if (previous !== source.sha) {
      switchCurrent(ctx, source.sha, journal, plan.current?.raw || null)
      appendHistory(ctx, { at: new Date().toISOString(), sha: source.sha, previous, commit: source.commit, action: 'install', kit_tests: built.counts ? 'passed' : 'skipped' }, journal)
      changes.push(`current -> releases/${source.sha} (was ${previous || 'none'})`)
    }
    assertConfigDirsInside(ctx)
    applyLinks(ctx, plan.links, journal, changes)
    const broken = brokenLinks(ctx)
    if (broken.length) throw new InstallError(`links do not resolve after install: ${broken.join(', ')}`)
    for (const c of MCP_CLIENTS) {
      const p = plan.clients[c.id]
      if (p.skipped) continue
      c.apply(ctx, p, journal, changes)
    }

    const history = readHistory(ctx)
    const pruned = pruneReleases(ctx, history, source.sha, previous)
    for (const name of pruned) changes.push(`pruned release ${name}`)

    out('')
    out(`installed: ${source.sha} (commit ${source.commit})`)
    out(`previous:  ${previous || 'none'}`)
    for (const c of MCP_CLIENTS) {
      const p = plan.clients[c.id]
      if (p.skipped) continue
      const detail = c.detailApplied?.(ctx, p)
      if (detail) out(detail)
    }
    out(changes.length ? `changed:\n${changes.map((c) => `  - ${c}`).join('\n')}` : 'changed: nothing (already installed and registered)')
    out(`rollback:  ${rollbackCommand(ctx)}`)
    out(RESTART)
  } catch (error) {
    if (built && lstatOrNull(built.dir)) built.cleanup()
    const undone = journal.rollback()
    if (undone.length) error.message += `\nthis run was rolled back:\n${undone.map((u) => `  ${u}`).join('\n')}`
    throw error
  }
}

// ── rollback ───────────────────────────────────────────────────────────────

function rollback(ctx) {
  const current = readCurrent(ctx)
  if (!current) throw new InstallError(`nothing is installed: ${ctx.currentPath} does not exist`)
  const history = readHistory(ctx)
  const target = rollbackTarget(ctx, history, current.sha)
  if (!target) throw new InstallError(`no earlier release to roll back to from ${current.sha} (history: ${ctx.historyPath})`)
  const links = planLinks(ctx)
  const missing = REQUIRED_PATHS.filter((rel) => !lstatOrNull(path.join(ctx.releasesDir, target, rel)))

  if (ctx.opts.dryRun) {
    out(`DRY RUN — nothing was changed.`)
    out(`would switch current: ${current.sha} -> ${target}`)
    for (const l of links) {
      if (l.action === 'ok') continue
      out(l.posixCopy || l.content === null ? `would ${plannedAction(l)} copy ${l.dest} <- ${l.target}` : `would ${l.action} link ${l.dest} -> ${l.target}`)
    }
    // Copies and symlinks end differently when the older release lacks the
    // source: applyLinks keeps an installed copy (skills, agents, the rule)
    // exactly as it is, while a symlink to a missing path really does dangle.
    // These paths come from REQUIRED_PATHS, which is wider than linkSpecs —
    // one of them (the MCP server, the collab tests) is not a link
    // destination at all, and what a rollback does to those is outside what
    // this line can say.
    if (missing.length) {
      out(
        `warning: release ${target} lacks ${missing.join(', ')}; of the ones this installer links, an installed copy is kept as it is now and a symlink would dangle`
      )
    }
    return
  }

  const journal = new Journal()
  const changes = []
  try {
    switchCurrent(ctx, target, journal, current.raw)
    appendHistory(ctx, { at: new Date().toISOString(), sha: target, previous: current.sha, action: 'rollback' }, journal)
    changes.push(`current -> releases/${target} (was ${current.sha})`)
    assertConfigDirsInside(ctx)
    applyLinks(ctx, links, journal, changes)
  } catch (error) {
    const undone = journal.rollback()
    if (undone.length) error.message += `\nthis run was rolled back:\n${undone.map((u) => `  ${u}`).join('\n')}`
    throw error
  }
  out(`rolled back: ${current.sha} -> ${target}`)
  out(`changed:\n${changes.map((c) => `  - ${c}`).join('\n')}`)
  const broken = brokenLinks(ctx)
  if (broken.length) out(`warning: these links do not resolve in ${target}: ${broken.join(', ')}`)
  out('registrations (Claude, Codex) point at ~/.agent-kit/current and need no change.')
  out(`to return to ${current.sha}: run the installer on that commit, or --rollback again to go further back.`)
  out(RESTART)
}

// ── main ───────────────────────────────────────────────────────────────────

async function main(argv) {
  const opts = parseArgs(argv)
  if (opts.help) {
    out(HELP)
    return 0
  }
  const ctx = makeContext(opts)
  const release = opts.dryRun ? () => {} : acquireLock(ctx)
  try {
    if (opts.rollback) rollback(ctx)
    else await install(ctx)
  } finally {
    release()
  }
  return 0
}

module.exports = {
  parseArgs,
  resolveClaudeConfigDirs,
  assertConfigDirsInside,
  tapVerdict,
  rewriteCodexToml,
  codexBlock,
  parseClaudeGet,
  rollbackTarget,
  normalizeKey,
  resolveNode,
  compareToolNames,
  missingPaths,
  cmdShimContent,
  // Exported for tests only: the Windows link planner/applier cannot be
  // exercised end-to-end on POSIX, and its plan-time/apply-time split is
  // exactly where a missing source in `current` used to refuse the install
  // (2026-09-17). A direct unit test is the only check this machine can run.
  linkSpecs,
  planLinksWindows,
  applyLinksWindows,
  Journal
}

if (require.main === module) {
  main(process.argv.slice(2)).then(
    (code) => {
      process.exitCode = code
    },
    (error) => {
      process.stderr.write(`agent-kit-install: ${error instanceof InstallError ? error.message : error.stack || error}\n`)
      process.exitCode = 1
    }
  )
}
